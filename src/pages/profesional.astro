---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Profesional">

  <section class="prof section" id="prof">
    <div class="container">
      <div class="section-label">// 06. PROFESIONAL</div>
      <div class="prof-grid">
        <div class="prof-intro">
          <h2 class="section-title">ACM <span class="accent">Professional</span></h2>
          <p>
            ¿Eres egresado, docente o profesional del rubro tech? El ACM Student Chapter 
            UCSM está abierto a la colaboración de ponentes, mentores, instituciones y 
            empresas que deseen aportar a la formación de nuevos talentos.
          </p>
          <ul class="prof-benefits">
            <li>Comparte tu experiencia en charlas, talleres y keynotes</li>
            <li>Conecta con estudiantes talentosos y futuros profesionales</li>
            <li>Asesora proyectos de investigación e innovación</li>
            <li>Accede a la red global ACM y sus publicaciones</li>
            <li>Contribuye al ecosistema tech universitario del Perú</li>
          </ul>
        </div>
        <div>
          <div class="prof-options">
            <div class="prof-card">
              <span class="prof-card-icon">🎤</span>
              <h3>Ponente</h3>
              <p>Dicta charlas, talleres o seminarios especializados en tu área de expertise.</p>
            </div>
            <div class="prof-card">
              <span class="prof-card-icon">🏛️</span>
              <h3>Institución</h3>
              <p>Tu organización puede sponsorear eventos, ofrecer pasantías o reclutar talento.</p>
            </div>
            <div class="prof-card">
              <span class="prof-card-icon">🎓</span>
              <h3>Egresado</h3>
              <p>Exalumnos UCSM que deseen mantenerse conectados y apoyar al capítulo.</p>
            </div>
            <div class="prof-card">
              <span class="prof-card-icon">🤝</span>
              <h3>Mentor</h3>
              <p>Guía a estudiantes en proyectos, investigación y desarrollo profesional.</p>
            </div>
          </div>
          <form class="prof-form" id="profForm" onsubmit="return handleProfSubmit(event)">
            <div class="form-group">
              <label>Nombre completo</label>
              <input type="text" placeholder="Tu nombre" required />
            </div>
            <div class="form-group">
              <label>Correo electrónico</label>
              <input type="email" placeholder="tu@correo.com" required />
            </div>
            <div class="form-group">
              <label>Perfil</label>
              <select class="form-select">
                <option value="">Selecciona tu perfil</option>
                <option>Ponente / Conferencista</option>
                <option>Docente / Investigador</option>
                <option>Egresado / Exalumno</option>
                <option>Empresa / Institución</option>
                <option>Mentor</option>
              </select>
            </div>
            <div class="form-group">
              <label>Mensaje</label>
              <textarea placeholder="Cuéntanos cómo te gustaría colaborar..." rows="4"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-full">Enviar →</button>
            <div class="form-success" id="profSuccess">¡Gracias! Te contactaremos pronto.</div>
          </form>
        </div>
      </div>
    </div>
  </section>
  <script type="module" src={base + "/src/scripts/profesional.js"}></script>
</BaseLayout>