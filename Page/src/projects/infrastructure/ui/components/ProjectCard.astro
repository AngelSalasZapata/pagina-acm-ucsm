---
import type { Project } from '../../../domain/project';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="project-card">
  <div class="card-img">
    <img src={project.image} alt={project.title} loading="lazy" />
  </div>
  <div class="card-body">
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="card-tags">
      {project.tags.map(tag => <span>{tag}</span>)}
    </div>
    <a href={project.link} target="_blank" class="card-link">{project.linkText}</a>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: rgba(13, 20, 13, 0.95);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.4),
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
    cursor: default;
    opacity: 0.75;
    transition: opacity 0.2s;
    will-change: transform, opacity;
  }

  .project-card:hover {
    scale: 1.05;
    opacity: 1;
    box-shadow:
      0 4px 16px rgba(0, 230, 118, 0.15),
      0 12px 48px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    z-index: 100 !important;
  }

  .card-img {
    width: 100%;
    flex: 1;
    overflow: hidden;
    min-height: 0;
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-body h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1rem;
    color: #f6f4f3;
    margin: 0;
    line-height: 1.2;
  }

  .card-body p {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    color: rgba(246, 244, 243, 0.65);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .card-tags span {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--green);
    letter-spacing: -0.01em;
  }

  .card-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: var(--green);
    text-decoration: none;
    margin-top: 4px;
    transition: opacity 0.2s;
    opacity: 0.8;
  }

  .card-link:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .card-img {
      min-height: 120px;
    }

    .card-body {
      padding: 8px 10px 10px;
    }

    .card-body h3 {
      font-size: 0.85rem;
    }

    .card-body p {
      font-size: 0.65rem;
      -webkit-line-clamp: 2;
    }

    .card-tags span {
      font-size: 0.55rem;
    }
  }
</style>
