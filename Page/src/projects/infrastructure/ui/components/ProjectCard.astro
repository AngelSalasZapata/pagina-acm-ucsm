---
import type { Project } from '../../../domain/project';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="project-card" data-flipped="false">
  <div class="card-inner">
    <div class="card-front">
      <div class="card-img">
        <img src={project.image} alt={project.title} loading="lazy" />
      </div>
      <div class="card-body">
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <div class="card-tags">
          {project.tags.map(tag => <span>{tag}</span>)}
        </div>
        <a href={project.link} target="_blank" class="card-link">{project.linkText}</a>
      </div>
    </div>
    <div class="card-back">
      <h3>{project.title}</h3>
      <p>{project.description}</p>
      <div class="card-back-info">
        <span>Tecnologías: {project.tags.join(', ')}</span>
        <span>Área: {project.area}</span>
        <span>Actualizado: {project.updatedAt}</span>
      </div>
      <a href={project.link} target="_blank" class="card-link">{project.linkText}</a>
    </div>
  </div>
</div>

<style>
  .project-card {
    perspective: 1000px;
    border-radius: 6px;
    cursor: default;
    opacity: 0.75;
    transition: opacity 0.2s;
    will-change: transform, opacity;
  }

  .project-card:hover {
    scale: 1.05;
    opacity: 1;
    z-index: 100 !important;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s ease;
    transform-style: preserve-3d;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(13, 20, 13, 0.95);
    border: 1px solid var(--border);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.4),
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .project-card.flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-front, .card-back {
    backface-visibility: hidden;
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  .card-back {
    transform: rotateY(180deg);
    padding: 16px;
    justify-content: center;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .card-front {
    display: flex;
    flex-direction: column;
  }

  .card-img {
    width: 100%;
    flex: 1;
    overflow: hidden;
    min-height: 0;
    cursor: pointer;
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .card-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-body h3, .card-back h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1rem;
    color: #f6f4f3;
    margin: 0;
    line-height: 1.2;
  }

  .card-body p {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    color: rgba(246, 244, 243, 0.65);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-back p {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    color: rgba(246, 244, 243, 0.65);
    line-height: 1.4;
    margin: 0;
  }

  .card-back-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    color: rgba(246, 244, 243, 0.5);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .card-tags span {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--green);
    letter-spacing: -0.01em;
  }

  .card-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: var(--green);
    text-decoration: none;
    margin-top: 4px;
    transition: opacity 0.2s;
    opacity: 0.8;
  }

  .card-link:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .card-img {
      min-height: 120px;
    }

    .card-body {
      padding: 8px 10px 10px;
    }

    .card-body h3, .card-back h3 {
      font-size: 0.85rem;
    }

    .card-body p {
      font-size: 0.65rem;
      -webkit-line-clamp: 2;
    }

    .card-tags span {
      font-size: 0.55rem;
    }

    .card-back {
      padding: 10px;
    }

    .card-back p {
      font-size: 0.65rem;
    }
  }
</style>


