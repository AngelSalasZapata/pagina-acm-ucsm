<canvas id="ascii-canvas" class="ascii-canvas"></canvas>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

  if (window.innerWidth >= 520) init();

  async function init() {
    const canvas = document.getElementById('ascii-canvas');
    if (!canvas) return;
    console.log('[AsciiViewer] init');

    const parent = canvas.parentElement;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
    const glCtx = renderer.getContext();
    const maxRB = glCtx ? glCtx.getParameter(glCtx.MAX_RENDERBUFFER_SIZE) : 2048;
    const pr = Math.max(1, Math.min(devicePixelRatio, 1.5, maxRB / (parent.clientWidth || 800)));
    renderer.setPixelRatio(pr);
    renderer.setClearColor(0x000000, 0);
    console.log('[AsciiViewer] renderer ready, maxRB:', maxRB, 'pr:', pr);

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 50);
    camera.position.set(0, 0.5, 5);

    scene.add(new THREE.AmbientLight(0xffffff, 0.3));
    const l1 = new THREE.DirectionalLight(0xffffff, 5); l1.position.set(3, 4, 6); scene.add(l1);
    const l2 = new THREE.DirectionalLight(0xffffff, 0.5); l2.position.set(-3, 1, 4); scene.add(l2);

    const group = new THREE.Group();
    scene.add(group);

    let mixer = null, action = null, finished = false;
    let rotY = 0, autoRotate = false, dragging = false, lx = 0, ly = 0, dx = 0, dy = 0;
    window.__startAutoRotate = () => { autoRotate = true; };
    window.__restartAnim = () => { if (mixer && action) { finished = false; mixer.stopAllAction(); action.play(); } };
    window.__zoomCamera = (z, d) => {
      if (!z) { camera.position.z = z; camera.updateProjectionMatrix(); return; }
    };

    const models = [
      '/visible_interactive_human_-_exploding_skull.glb',
      '/heart_-_animated_anatomical_3d_model.glb',
    ];
    const modelPath = models[Math.floor(Math.random() * models.length)];
    const isSkull = modelPath.includes('skull');
    const isHeart = modelPath.includes('heart');
    console.log('[AsciiViewer] loading:', modelPath);

    if (isHeart) { group.scale.setScalar(0.010); group.position.y = 0.6; }
    if (isSkull) { group.scale.setScalar(0.13); group.position.set(0.4, 0.2, 0); }

    new GLTFLoader().load(modelPath, gltf => {
      console.log('[AsciiViewer] model loaded:', modelPath);
      if (isSkull || isHeart) {
        const mat = new THREE.MeshStandardMaterial({ color: 0x826cf6, roughness: 0.12, metalness: 0 });
        gltf.scene.traverse(o => { if (o.isMesh) { if (o.material) o.material.dispose(); o.material = mat; } });
      }
      group.add(gltf.scene);
      if (gltf.animations && gltf.animations.length) {
        mixer = new THREE.AnimationMixer(gltf.scene);
        let clip = gltf.animations[0];
        if (isSkull && clip.duration) {
          const half = clip.duration * 0.5;
          const newTracks = clip.tracks.map(t => {
            const idx = [];
            for (let i = 0; i < t.times.length; i++) { if (t.times[i] >= half) idx.push(i); }
            const vpk = t.values.length / t.times.length;
            const times = new Float32Array(idx.length);
            const values = new Float32Array(idx.length * vpk);
            for (let j = 0; j < idx.length; j++) {
              times[j] = t.times[idx[j]] - half;
              for (let k = 0; k < vpk; k++) values[j * vpk + k] = t.values[idx[j] * vpk + k];
            }
            return new t.constructor(t.name, times, values);
          });
          clip = new THREE.AnimationClip('skull_half', clip.duration - half, newTracks);
        }
        const startTime = !isSkull && isHeart ? clip.duration * 0.56 : 0;
        action = mixer.clipAction(clip);
        action.setLoop(isHeart ? THREE.LoopRepeat : THREE.LoopOnce);
        action.clampWhenFinished = !isHeart;
        action.play();
        action.time = startTime;
      }
    }, undefined, err => console.error('[AsciiViewer] load error', err));

    function resize() {
      const w = parent.clientWidth, h = parent.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    requestAnimationFrame(() => requestAnimationFrame(resize));
    new ResizeObserver(resize).observe(parent);

    canvas.addEventListener('pointerdown', e => { dragging = true; lx = e.clientX; ly = e.clientY; });
    window.addEventListener('pointermove', e => {
      if (!dragging) return;
      dy += (e.clientY - ly) * 0.005;
      dx += (e.clientX - lx) * 0.005;
      lx = e.clientX; ly = e.clientY;
    });
    window.addEventListener('pointerup', () => { dragging = false; });

    const clock = new THREE.Clock();
    let composer = null;

    if (isSkull || isHeart) {
      let fc = 0;
      (function tryEffect() {
        fc++;
        if (fc < 12) { requestAnimationFrame(tryEffect); return; }
        loadEffect();
      })();
    }

    async function loadEffect() {
      try {
        const w = parent.clientWidth, h = parent.clientHeight;
        if (!w || !h) { requestAnimationFrame(loadEffect); return; }

        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();

        const pp = await import('postprocessing');

        const SYMBOLS = '.:-=+*#%@NMWB8$▓▒░';
        const glyphTex = (() => {
          const c = document.createElement('canvas');
          c.width = 64 * SYMBOLS.length; c.height = 64;
          const x = c.getContext('2d');
          if (!x) return null;
          x.fillStyle = '#000'; x.fillRect(0, 0, c.width, c.height);
          x.fillStyle = '#fff'; x.font = '62px monospace';
          x.textAlign = 'center'; x.textBaseline = 'middle';
          for (let i = 0; i < SYMBOLS.length; i++) x.fillText(SYMBOLS[i], i * 64 + 32, 32);
          const t = new THREE.CanvasTexture(c);
          t.needsUpdate = true;
          t.minFilter = t.magFilter = THREE.LinearFilter;
          return t;
        })();

        const frag = `
uniform float cellSize;
uniform bool invert;
uniform vec2 resolution;
uniform sampler2D glyphAtlas;
uniform float glyphTiles;
uniform bool useGlyphAtlas;
void mainImage(const in vec4 _,const in vec2 u,out vec4 o){
  vec4 cl=texture(inputBuffer,u);
  float br=dot(cl.rgb,vec3(.299,.587,.114));
  if(br<0.04){o=vec4(0,0,0,0);return;}
  vec2 lv=fract(u*resolution/cellSize);
  float cv;
  if(useGlyphAtlas&&glyphTiles>0.){
    float ti=clamp(floor(br*glyphTiles),0.,glyphTiles-1.);
    cv=texture(glyphAtlas,vec2((ti+0.02+lv.x*(1.-0.04))/glyphTiles,0.02+lv.y*(1.-0.04))).r;
  } else {
    float g=clamp((br-.1)*1.4,0.,1.);
    cv=g;
  }
  vec3 fc=cl.rgb*cv;
  o=vec4(fc,cl.a);
}`;

        class AsciiFX extends pp.Effect {
          constructor() {
            super('AsciiFX', frag, {
              blendFunction: pp.BlendFunction.NORMAL,
              uniforms: new Map([
                ['cellSize', new THREE.Uniform(8)],
                ['invert', new THREE.Uniform(false)],
                ['resolution', new THREE.Uniform(new THREE.Vector2(renderer.domElement.width, renderer.domElement.height))],
                ['glyphAtlas', new THREE.Uniform(glyphTex)],
                ['glyphTiles', new THREE.Uniform(SYMBOLS.length)],
                ['useGlyphAtlas', new THREE.Uniform(!!glyphTex)],
              ])
            });
          }
          update(_, __, dt) { }
        }

        const fx = new AsciiFX();
        const resizeFX = () => {
          const w2 = parent.clientWidth, h2 = parent.clientHeight;
          if (!w2 || !h2) return;
          renderer.setSize(w2, h2);
          camera.aspect = w2 / h2;
          camera.updateProjectionMatrix();
          fx.uniforms.get('resolution').value.set(renderer.domElement.width, renderer.domElement.height);
          if (composer) composer.setSize(renderer.domElement.width, renderer.domElement.height);
        };
        new ResizeObserver(resizeFX).observe(parent);
        resizeFX();

        const comp = new pp.EffectComposer(renderer);
        comp.addPass(new pp.RenderPass(scene, camera));
        const ep = new pp.EffectPass(camera, fx);
        ep.renderToScreen = true;
        comp.addPass(ep);
        resizeFX();

        composer = comp;
        console.log('[AsciiViewer] ASCII effect active');
      } catch (e) {
        console.warn('[AsciiViewer] ASCII unavailable, raw render continues', e);
      }
    }

    (function loop() {
      requestAnimationFrame(loop);
      const dt = Math.min(clock.getDelta(), 0.05);
      if (mixer && !finished) {
        mixer.update(dt);
        if (action && action.time >= action.getClip().duration - 0.01 && !isHeart) finished = true;
      }
      if (autoRotate && !dragging) rotY += dt * 0.4;
      group.rotation.x = dy + 0.3;
      group.rotation.y = dx + rotY;
      group.rotation.z = -0.08;
      if (composer) {
        renderer.setRenderTarget(null);
        renderer.clear();
        composer.render(dt);
      } else {
        renderer.render(scene, camera);
      }
    })();
  }
</script>

<style>
  .ascii-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
