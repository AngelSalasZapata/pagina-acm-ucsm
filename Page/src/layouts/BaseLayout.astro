---
// src/layouts/BaseLayout.astro
interface Props {
  title?: string;
  description?: string;
}

import '../styles/styles.css';

const {
  title = "ACM Student Chapter",
  description = "Capítulo estudiantil de la Association for Computing Machinery · Universidad Católica de Santa María"
} = Astro.props;

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Normaliza la ruta eliminando la barra final (excepto en "/")
const currentPath = path === "/" ? "/" : path.replace(/\/$/, "");

---


<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · ACM SC</title>

  <link rel="stylesheet" href="/styles.css" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&amp;family=Syne:wght@400;600;700;800&amp;family=Inter:wght@300;400;500&amp;family=Share+Tech+Mono&amp;family=Orbitron:wght@400;700;900&amp;family=VT323&amp;display=swap"
    rel="stylesheet"
  />
</head>
<body>

  <!-- ═══════════════════════════════════════
       BACKGROUND COMPARTIDO (grid + partículas + rings)
  ═══════════════════════════════════════ -->
  <div class="bg-layer">
    <div class="hero-grid-overlay"></div>
    <canvas id="bgCanvas" class="bg-canvas"></canvas>
    <div class="hero-ring" style="width:600px;height:600px;left:50%;top:50%;margin-left:-300px;margin-top:-300px;"></div>
    <div class="hero-ring" style="width:900px;height:900px;left:50%;top:50%;margin-left:-450px;margin-top:-450px;animation-delay:1s;"></div>
    <div class="hero-ring" style="width:1200px;height:1200px;left:50%;top:50%;margin-left:-600px;margin-top:-600px;animation-delay:2s;"></div>
    <div class="hero-ring" style="width:1500px;height:1500px;left:50%;top:50%;margin-left:-750px;margin-top:-750px;animation-delay:3s;"></div>
  </div>

  <!-- ═══════════════════════════════════════
       NAVBAR
  ═══════════════════════════════════════ -->
  <nav class="navbar" id="navbar">

    <div class="nav-inner">

      <a href={`${base}`} class="nav-logo" aria-label="ACM Student Chapter - Inicio">
        <span class="logo-bracket">[</span>ACM<span class="logo-accent">_SC</span><span class="logo-bracket">]</span>
      </a>

      <ul class="nav-links" id="navLinks" role="list">
        <li>
          <a
            href={`${base}nosotros`}
            class:list={[{ active: currentPath === "/nosotros" }]}
          >Nosotros</a>
        </li>
        <li>
          <a
            href={`${base}informacion`}
            class:list={[{ active: currentPath === "/informacion" }]}
          >Info</a>
        </li>
        <li>
          <a
            href={`${base}eventos`}
            class:list={[{ active: currentPath === "/eventos" }]}
          >Eventos</a>
        </li>
        <li>
          <a
            href={`${base}galeria`}
            class:list={[{ active: currentPath === "/galeria" }]}
          >Galería</a>
        </li>
        <li>
          <a
            href={`${base}unete`}
            class:list={[{ active: currentPath === "/unete" }, "nav-cta"]}
          >Únete</a>
        </li>
      </ul>

      <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks">
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>
  </nav>

  <!-- ═══════════════════════════════════════
       CONTENIDO DE LA PÁGINA
  ═══════════════════════════════════════ -->
  <main>
    <slot />
  </main>

  
  <!-- ═══════════════════════════════════════
       FOOTER
  ═══════════════════════════════════════ -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">

        <div class="footer-brand">
          <div class="footer-logo">
            <span class="logo-bracket">[</span>ACM<span class="logo-accent">_SC</span><span class="logo-bracket">]</span>
          </div>
          <p>ACM Student Chapter · Universidad Católica de Santa María<br/>Todos los derechos reservados © 2026</p>
        </div>


        <div class="footer-credit">
          <span>Hecho con <span class="accent">♥</span> por estudiantes, para estudiantes</span>
        </div>

      </div>
    </div>
</footer>

  <script>
    // Navbar scroll effect
    const navbar = document.getElementById('navbar');
    if (navbar) {
      window.addEventListener('scroll', () => {
        navbar.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });
    }

    // Hamburger menu toggle
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    if (hamburger && navLinks) {
      hamburger.addEventListener('click', () => {
        navLinks.classList.toggle('open');
        const spans = hamburger.querySelectorAll('span');
        const isOpen = navLinks.classList.contains('open');
        hamburger.setAttribute('aria-expanded', isOpen);
        if (isOpen) {
          spans[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
          spans[1].style.opacity = '0';
          spans[2].style.transform = 'rotate(-45deg) translate(5px, -5px)';
        } else {
          spans.forEach(s => { s.style.transform = ''; s.style.opacity = ''; });
        }
      });

      navLinks.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          navLinks.classList.remove('open');
          hamburger.setAttribute('aria-expanded', 'false');
          const spans = hamburger.querySelectorAll('span');
          spans.forEach(s => { s.style.transform = ''; s.style.opacity = ''; });
        });
      });
    }
  </script>

  <script>
    const canvas = document.getElementById('bgCanvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let W, H;

      function resizeCanvas() {
        W = canvas.width = window.innerWidth;
        H = canvas.height = window.innerHeight;
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas, { passive: true });

      const PARTICLE_COUNT = 60;
      const particles = Array.from({ length: PARTICLE_COUNT }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        r: Math.random() * 2 + 1,
        opacity: Math.random() * 0.4 + 0.3
      }));

      let mouseX = -999, mouseY = -999;
      canvas.addEventListener('mousemove', e => {
        const rect = canvas.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });

      function drawParticles() {
        if (!ctx) return;
        ctx.clearRect(0, 0, W, H);
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0) p.x = W;
          if (p.x > W) p.x = 0;
          if (p.y < 0) p.y = H;
          if (p.y > H) p.y = 0;

          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 100 && dist > 0) {
            const force = ((100 - dist) / 100) * 0.8;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
            const maxV = 2;
            p.vx = Math.max(-maxV, Math.min(maxV, p.vx));
            p.vy = Math.max(-maxV, Math.min(maxV, p.vy));
          }
          p.vx *= 0.998;
          p.vy *= 0.998;

          p.vx += (Math.random() - 0.5) * 0.015;
          p.vy += (Math.random() - 0.5) * 0.015;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(0, 230, 118, ${p.opacity})`;
          ctx.fill();

          for (let j = i + 1; j < particles.length; j++) {
            const q = particles[j];
            const qx = p.x - q.x;
            const qy = p.y - q.y;
            const d = Math.sqrt(qx * qx + qy * qy);
            if (d < 120) {
              const alpha = (1 - d / 120) * 0.3;
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(q.x, q.y);
              ctx.strokeStyle = `rgba(0, 230, 118, ${alpha})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(drawParticles);
      }
      drawParticles();
    }
  </script>

</body>
</html>

<!-- ═══════════════════════════════════════════════════════════
     ESTILOS ADICIONALES: link activo en navbar
     (Se combinan con tu styles.css global)
═══════════════════════════════════════════════════════════ -->
<style>
  /* Resalta el link de la página actual */
  .nav-links a.active {
    color: var(--green) !important;
  }

  /* Pequeño indicador debajo del link activo */
  .nav-links a.active:not(.nav-cta) {
    position: relative;
  }

  .nav-links a.active:not(.nav-cta)::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--green);
  }

  /* nav-cta activo tiene fondo sólido */
  .nav-links a.nav-cta.active {
    background: var(--green) !important;
    color: var(--bg) !important;
  }

  /* Asegura que main ocupe espacio mínimo para el footer quede abajo */
  main {
    min-height: calc(100vh - 70px);
    position: relative;
    z-index: 1;
  }
</style>
