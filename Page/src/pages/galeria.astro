---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGalleryItems } from '../galeria/application/gallery';
import '../galeria/infrastructure/ui/styles/gallery.css';
const items = getGalleryItems();
---
<BaseLayout title="Galería">
  <section class="gallery section" id="gallery">
    <div class="container">
      <div class="section-label">// 04. GALERÍA</div>
      <h2 class="section-title">Momentos <span class="accent">memorables</span></h2>
      <div class="gallery-grid">
        {items.map(item => (
          <div class={`gitem${item.layout === 'large' ? ' gitem--large' : ''}${item.layout === 'wide' ? ' gitem--wide' : ''}`}>
            <img src={item.src} alt={item.caption} loading="lazy" />
            <div class="gitem-overlay"><span>{item.caption}</span></div>
          </div>
        ))}
      </div>
      <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lbClose">✕</button>
        <button class="lightbox-nav lb-prev" id="lbPrev">‹</button>
        <img src="" alt="" id="lbImg" />
        <div class="lb-caption" id="lbCaption"></div>
        <button class="lightbox-nav lb-next" id="lbNext">›</button>
      </div>
    </div>
  </section>
  <script>import('../galeria/infrastructure/ui/scripts/gallery.js');</script>
</BaseLayout>
