---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiViewer from '../components/AsciiViewer.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Inicio">
  <div id="boot-screen" class="boot-screen">
    <div id="boot-output" class="boot-output"></div>
  </div>

  <section class="hero" id="hero">
    <div class="hero-layout">
      <div class="hero-content">
        <p class="hero-suptitle">UNIVERSIDAD CATÓLICA DE SANTA MARÍA</p>
        <h1 class="hero-acm">ACM</h1>
        <p class="hero-sub">Association for Computing Machinery</p>
        <p class="hero-sub">Student Chapter</p>

        <div class="hero-terminal">
          <div class="terminal-line" id="tline1">&nbsp;</div>
          <div class="terminal-line" id="tline2">&nbsp;</div>
        </div>

        <div class="hero-ctas">
          <a href={base + "eventos"} class="btn btn-event">
            <video class="btn-bg-video" src="/navbar-bg.mp4" autoplay muted loop playsinline></video>
            <span class="btn-text">VER EVENTOS →</span>
          </a>
          <a href={base + "nosotros"} class="btn btn-ghost">CONOCE MÁS</a>
        </div>
      </div>

      <div class="hero-model">
        <AsciiViewer />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const bootScreen = document.getElementById('boot-screen');
  const bootOutput = document.getElementById('boot-output');

  // hide main content during boot
  const hero = document.querySelector('.hero');
  if (hero) hero.style.opacity = '0';

  if (bootScreen && bootOutput) {

    const now = new Date();
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const month = months[now.getMonth()];
    const day = String(now.getDate()).padStart(2, '0');
    function ts(sec) {
      const d = new Date(now);
      d.setSeconds(d.getSeconds() - 20 + sec);
      const hh = String(d.getHours()).padStart(2, '0');
      const mm = String(d.getMinutes()).padStart(2, '0');
      const ss = String(d.getSeconds()).padStart(2, '0');
      return `${month} ${day} ${hh}:${mm}:${ss}`;
    }

    const bootLines = [];
    const pid = () => Math.floor(Math.random() * 9999) + 1;
    const pick = arr => arr[Math.floor(Math.random() * arr.length)];

    const kernels = [
      'Linux version 6.8.0-arch1-1 (build@archlinux) (gcc 14.2.1) #1 SMP PREEMPT_DYNAMIC',
      'Command line: BOOT_IMAGE=/boot/vmlinuz-linux root=UUID=a1b2c3d4 rw quiet splash',
      'x86/fpu: x87 FPU will use FXSAVE',
      'ACPI: Local APIC address 0xfee00000',
      'ACPI: 6 ACPI AML tables successfully acquired',
      'PCI: BIOS Bug: MCFG area at e000 not reserved in ACPI',
      'pci 0000:00:00.0: [8086:2e30] type 00 class 0x060000',
      'pci 0000:00:02.0: [8086:2e32] type 00 class 0x030000',
      'pci 0000:00:1a.0: EHCI: BIOS handoff failed',
      'ENERGY_PERF_BIAS: Set to normal',
      'clocksource: tsc: mask: 0xffffffffffffffff max_cycles: 0x1d8',
      'Freeing SMP alternatives memory: 40K',
      'SMP: Total of 8 processors activated',
      'smpboot: CPU0: Intel Xeon E3-1230 v3 (family: 0x6 model: 0x3c)',
      'mce: CPU0: Thermal monitoring enabled',
      'PCI: 46 PCI devices found, 5 VGA devices',
      'pci 0000:01:00.0: vgaarb: VGA device added',
      'svc: VMware vSockets: successfully loaded',
      'serio: i8042 keyboard controller connected',
      'rtc_cmos 00:03: RTC can wake from S4',
      'input: AT Translated Set 2 keyboard as /devices/platform/i8042/serio0',
      'usb 1-1: new high-speed USB device number 2 using ehci-pci',
      'EDAC sbridge: Seeking for memory errors',
      'ata1: SATA link up 6.0 Gbps',
      'scsi 0:0:0:0: Direct-Access ATA Samsung SSD 870 2B6Q',
      'EXT4-fs (sda2): mounted filesystem with ordered data mode',
      'kvm: already loaded, disabling virtualization',
      'loop0: detected capacity change from 0 to 8',
      'usbcore: registered new interface driver usbhid',
      'hid-generic 0003:046D:C077.0001: input: USB HID v1.11 Mouse',
      'IPv6: ADDRCONF(NETDEV_UP): enp0s3: link is not ready',
      'e1000: enp0s3 NIC Link is Up 1000 Mbps Full Duplex',
      'NET: Registered protocol family 17',
      'audit: initializing netlink socket',
      'selinux: initialized (dev sda2, type ext4)',
      'Bluetooth: Core ver 2.22',
      'ath5k: ar2425: registered as ieee80211 phy0',
      'iwlwifi: loaded firmware version 77.2e9d3f6b.0',
      'tpm_tis: 1.2 TPM (device ID 0x3204)',
      'random: crng init done',
      'EDAC: MC0: Giving out device',
      'cpufreq: intel_pstate registered',
      'iTCO_vendor_support: vendor-support=0',
      'dmesg: printk: console enabled',
      'ACPI: button: Power Button (FF) registered',
      'nvme nvme0: 8 NVMe namespaces',
      'pcieport 0000:00:1c.5: AER: enabled',
    ];

    const systemdServices = [
      ['systemd', 'systemd', [
        'Starting Journal Service...',
        'Reached target Local File Systems',
        'Starting Remount Root and Kernel File Systems...',
        'Started Remount Root and Kernel File Systems',
        'Starting Load Kernel Modules...',
        'Started Load Kernel Modules',
        'Starting Apply Kernel Variables...',
        'Started Apply Kernel Variables',
        'Mounting POSIX Message Queue File System...',
        'Mounted POSIX Message Queue File System',
        'Starting Create Static Device Nodes...',
        'Started Create Static Device Nodes',
        'Reached target Preparation for Local File Systems',
        'Starting udev Kernel Device Manager...',
        'Started udev Kernel Device Manager',
        'Starting udev Coldplug all Devices...',
        'Started udev Coldplug all Devices',
        'Starting Network Configuration...',
        'Started Network Configuration',
        'Reached target Network',
        'Starting Permit User Sessions...',
        'Started Permit User Sessions',
        'Starting ACM System Services...',
        'Started ACM System Services',
        'Reached target Multi-User System',
        'Started ACM Node.js Backend',
        'Started ACM PostgreSQL Service',
        'Reached target Graphical Interface',
        'Started Update UTMP about System Runlevel Changes',
        'systemd: Startup finished in 2.481s',
      ]],
      ['NetworkManager', 'NetworkManager', [
        'NetworkManager: <info> scanning for WiFi networks',
        'NetworkManager: <info> connected to "ACM-Staff"',
        'NetworkManager: <info> IPv4 configuration: dhcp',
        'NetworkManager: <info> address 192.168.1.42/24',
        'NetworkManager: <info> gateway 192.168.1.1',
        'NetworkManager: <info> DNS: 8.8.8.8, 1.1.1.1',
      ]],
      ['sshd', 'sshd', [
        'sshd: server listening on 0.0.0.0 port 22',
        'sshd: server listening on :: port 22',
        'sshd: re-exec requires execution with same path',
      ]],
      ['auditd', 'auditd', [
        'auditd: dispatcher started',
        'auditd: backlog limit set to 8192',
        'auditd: processing audit events',
      ]],
      ['cron', 'cron', [
        'cron: (root) CMD (run-parts /etc/cron.hourly)',
        'cron: (acm) CMD (/opt/acm/healthcheck.sh)',
        'cron: (acm) CMD (/opt/acm/sync-events.sh)',
      ]],
      ['backend', 'backend', [
        'ACM-backend: loading configuration from /etc/acm/config.yml',
        'ACM-backend: connecting to PostgreSQL on localhost:5432',
        'ACM-backend: database pool initialized (max: 20)',
        'ACM-backend: starting Express server on port 3000',
        'ACM-backend: ACM Student Chapter API ready',
        'ACM-backend: WebSocket server listening for live events',
        'ACM-backend: cache warming completed (4 members loaded)',
        'ACM-backend: ACM backend v3.2.1 initialized',
      ]],
    ];

    let sec = 0;
    const lineCount = 60;

    for (let i = 0; i < lineCount; i++) {
      const t = ts(sec);
      if (i < 50) {
        // kernel messages
        bootLines.push(`${t} ACM sys kernel: ${pick(kernels)}`);
      } else {
        const svc = pick(systemdServices);
        const svcName = svc[0];
        const msgs = svc[2];
        bootLines.push(`${t} ACM sys ${svcName}[${pid()}]: ${pick(msgs)}`);
      }
      sec += 0.066;
    }

    // terminal cursor blink style
    const blinkStyle = document.createElement('style');
    blinkStyle.textContent = `
      @keyframes boot-blink { 0%,100% { opacity:1 } 50% { opacity:0 } }
    `;
    document.head.appendChild(blinkStyle);

    let idx = 0;
    const batchSize = 2;

    function showBatch() {
      const fragment = document.createDocumentFragment();
      for (let j = 0; j < batchSize && idx < bootLines.length; j++, idx++) {
        const line = document.createElement('div');
        line.textContent = bootLines[idx];
        fragment.appendChild(line);
      }
      bootOutput.appendChild(fragment);
      bootOutput.scrollTop = bootOutput.scrollHeight;

      if (idx < bootLines.length) {
        requestAnimationFrame(showBatch);
      } else {
        // all lines shown → clear and show init messages
        setTimeout(() => {
          bootOutput.innerHTML = '';
          bootOutput.style.height = 'auto';
          bootScreen.classList.add('boot-screen--centered');
          const msgs = [
            '> inicializando ACM Student Chapter...',
            '> sistema listo. bienvenido.',
          ];

          function typeInit(lineIdx, charIdx, cursorEl) {
            if (charIdx < msgs[lineIdx].length) {
              cursorEl.before(document.createTextNode(msgs[lineIdx][charIdx]));
              requestAnimationFrame(() => typeInit(lineIdx, charIdx + 1, cursorEl));
            } else {
              cursorEl.remove();
              if (lineIdx + 1 < msgs.length) {
                const nextLine = document.createElement('div');
                const nextCursor = document.createElement('span');
                nextCursor.className = 'boot-cursor';
                nextLine.appendChild(nextCursor);
                bootOutput.appendChild(document.createElement('br'));
                bootOutput.appendChild(nextLine);
                requestAnimationFrame(() => typeInit(lineIdx + 1, 0, nextCursor));
              } else {
                // done → reveal content (with center-stage on desktop, immediate on mobile)
                setTimeout(() => {
                  bootScreen.style.transition = 'opacity 0.3s ease';
                  bootScreen.style.opacity = '0';
                  setTimeout(() => {
                    bootScreen.style.display = 'none';
                    if (hero) hero.style.opacity = '1';

                    const isMobile = window.innerWidth < 768;
                    const model = document.querySelector('.hero-model');
                    const content = document.querySelector('.hero-content');

                    if (isMobile || !model) {
                      // mobile: show everything immediately
                      if (content) content.style.opacity = '1';
                      return;
                    }

                    // desktop: center-stage animation — 2× canvas, compensated camera
                    if (content) content.style.opacity = '0';

                    if (window.__restartAnim) window.__restartAnim();

                    const heroEl = document.querySelector('.hero');
                    if (heroEl) heroEl.style.overflow = 'visible';

                    model.style.transition = 'none';
                    requestAnimationFrame(() => {
                      const rect = model.getBoundingClientRect();
                      const vpCenter = window.innerWidth / 2;
                      const modelCenter = rect.left + rect.width / 2;
                      const offset = vpCenter - modelCenter;
                      model.style.transform = `translateX(${offset}px) scale(1.5)`;
                      model.getBoundingClientRect();
                      if (window.__zoomCamera) window.__zoomCamera(6.75, 0);

                      setTimeout(() => {
                        if (window.__startAutoRotate) window.__startAutoRotate();

                        const dur = 900;
                        model.style.transition = `transform ${dur}ms linear`;
                        model.style.transform = 'translateX(0) scale(1)';
                        if (window.__zoomCamera) window.__zoomCamera(4.5, dur);

                        if (heroEl) heroEl.style.overflow = '';

                        if (content) {
                          content.style.transition = 'opacity 0.6s ease 0.3s';
                          content.style.opacity = '1';
                        }
                      }, 1000);
                    });
                  }, 350);
                }, 300);
              }
            }
          }

          const firstLine = document.createElement('div');
          const cursor = document.createElement('span');
          cursor.className = 'boot-cursor';
          firstLine.appendChild(cursor);
          bootOutput.appendChild(firstLine);
          requestAnimationFrame(() => typeInit(0, 0, cursor));
        }, 300);
      }
    }

    requestAnimationFrame(showBatch);
  }
</script>

<style>
  .boot-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    padding: 20px;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
  }

  .boot-screen--centered {
    align-items: center;
  }

  .boot-output {
    font-family: 'VT323', monospace;
    font-size: 18px;
    color: var(--green);
    width: 100%;
    height: 100%;
    overflow: hidden;
    line-height: 1.5;
    white-space: pre;
  }

  .boot-cursor {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    background: var(--green);
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: boot-blink 0.7s step-end infinite;
  }

  .boot-output div {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
  }

  .btn-event {
    position: relative;
    overflow: hidden;
    background: transparent !important;
    border: 1.5px solid var(--border);
    isolation: isolate;
  }

  .btn-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
  }

  .btn-text {
    position: relative;
    z-index: 1;
    color: #f6f4f3;
  }

  .btn-event:hover {
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px var(--green-glow);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: center;
    gap: 48px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    min-height: calc(100vh - 80px);
  }

  .hero-model {
    position: relative;
    width: 100%;
    height: clamp(450px, 60vh, 750px);
    min-height: 400px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    min-width: 0;
  }

  .hero-content .hero-acm {
    font-size: clamp(5rem, 10vw, 9rem);
    text-align: left;
  }

  .hero-content .hero-suptitle {
    text-align: left;
  }

  .hero-content .hero-sub {
    text-align: left;
  }

  @media (max-width: 768px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: 32px;
      min-height: auto;
      padding: 100px 24px 0;
    }

    .hero-content {
      align-items: center;
      text-align: center;
    }

    .hero-content .hero-acm {
      text-align: center;
    }

    .hero-content .hero-suptitle {
      text-align: center;
    }

    .hero-content .hero-sub {
      text-align: center;
    }

    .hero-content .hero-ctas {
      justify-content: center;
    }

    .hero-model {
      height: clamp(300px, 45vh, 500px);
      min-height: 250px;
    }
  }

  @media (max-width: 520px) {
    .hero-model {
      display: none;
    }
  }
</style>
