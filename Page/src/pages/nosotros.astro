---
// src/pages/nosotros.astro
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Nosotros">

    <!-- ABOUT -->
  <section class="about section" id="about">
    <div class="container">
      <div class="section-label">// 01. QUIÉNES SOMOS</div>
      <div class="about-grid">
        <div class="about-text">
          <h2 class="section-title">Impulsando el futuro <span class="accent">tecnológico</span> del Perú</h2>
          <p>Somos el capítulo estudiantil de la <strong>Association for Computing Machinery (ACM)</strong> de la Universidad Católica de Santa María, una comunidad de estudiantes apasionados por la ingeniería, ciencias, el desarrollo de software y la innovación tecnológica.</p>
          <p>Fundado para conectar a estudiantes con recursos académicos de clase mundial, organizamos talleres, hackathons, charlas con la industria y proyectos colaborativos que potencian las habilidades técnicas y profesionales de nuestros miembros.</p>
          <div class="about-badges">
            <span class="badge">Programación</span>
            <span class="badge">IA &amp; ML</span>
            <span class="badge">Ciberseguridad</span>
            <span class="badge">Open Source</span>
            <span class="badge">Redes</span>
            <span class="badge">Robótica</span>
            <span class="badge">Computación Cuántica</span>
          </div>
        </div>
        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-num-big">120+</div>
            <div class="stat-label-card">MIEMBROS ACTIVOS</div>
          </div>
          <div class="stat-card">
            <div class="stat-num-big">1°</div>
            <div class="stat-label-card">AÑO INICIANDO</div>
          </div>
          <div class="stat-card">
            <div class="stat-num-big">40+</div>
            <div class="stat-label-card">EVENTOS AL AÑO</div>
          </div>
          <div class="stat-card">
            <div class="stat-num-big">8</div>
            <div class="stat-label-card">PROYECTOS ACTIVOS</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SCROLL REVEAL SECTION ── -->
  <section class="scroll-reveal" id="scroll-reveal">
    <div class="separator-bar" id="separator-bar"></div>

    <div class="reveal-stage" id="reveal-stage">
      <div class="reveal-purple" id="reveal-purple">
        <div class="content-inner" style="max-width:920px">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(3rem,6vw,6rem);margin-bottom:24px">Nuestro equipo</h2>
          <div class="team-grid">
            <div class="team-card">
              <img class="team-avatar" src="/arelyx.jpg" alt="" draggable="false" />
              <span class="team-name">Andry Caceres</span>
              <span class="team-email">andry@ucsm.edu.pe</span>
            </div>
            <div class="team-card">
              <div class="team-avatar-placeholder"></div>
              <span class="team-name">Santiago Cusirramos</span>
              <span class="team-email">santiago@ucsm.edu.pe</span>
            </div>
            <div class="team-card">
              <div class="team-avatar-placeholder"></div>
              <span class="team-name">Fernando Pacheco</span>
              <span class="team-email">fernando@ucsm.edu.pe</span>
            </div>
            <div class="team-card">
              <div class="team-avatar-placeholder"></div>
              <span class="team-name">Christian Revilla</span>
              <span class="team-email">christian@ucsm.edu.pe</span>
            </div>
            <div class="team-card">
              <div class="team-avatar-placeholder"></div>
              <span class="team-name">Miembro 5</span>
              <span class="team-email">m5@ucsm.edu.pe</span>
            </div>
            <div class="team-card">
              <div class="team-avatar-placeholder"></div>
              <span class="team-name">Miembro 6</span>
              <span class="team-email">m6@ucsm.edu.pe</span>
            </div>
            <div class="team-card">
              <div class="team-avatar-placeholder"></div>
              <span class="team-name">Miembro 7</span>
              <span class="team-email">m7@ucsm.edu.pe</span>
            </div>
            <div class="team-card">
              <div class="team-avatar-placeholder"></div>
              <span class="team-name">Miembro 8</span>
              <span class="team-email">m8@ucsm.edu.pe</span>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal-green" id="reveal-green">
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px">Christian Revilla</h2>
          <div class="presidente-border-wrap">
            <svg class="presidente-border-svg">
              <rect fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="6" stroke-dasharray="16 12" />
            </svg>
            <p class="presidente-text" style="font-family:'VT323',monospace;color:#fff;font-size:clamp(2.2rem,4.5vw,3rem);background:#000;padding:0 14px;display:inline-block;margin:0;line-height:1.2">Sponsor</p>
          </div>
        </div>
      </div>

      <div class="reveal-blue" id="reveal-blue">
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px">Fernando Pacheco</h2>
          <div class="presidente-border-wrap">
            <svg class="presidente-border-svg">
              <rect fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="6" stroke-dasharray="16 12" />
            </svg>
            <p class="presidente-text" style="font-family:'VT323',monospace;color:#fff;font-size:clamp(2.2rem,4.5vw,3rem);background:#000;padding:0 14px;display:inline-block;margin:0;line-height:1.2">Tesorero</p>
          </div>
        </div>
      </div>

      <div class="reveal-red" id="reveal-red">
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px">Santiago Cusirramos</h2>
          <div class="presidente-border-wrap">
            <svg class="presidente-border-svg">
              <rect fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="6" stroke-dasharray="16 12" />
            </svg>
            <p class="presidente-text" style="font-family:'VT323',monospace;color:#fff;font-size:clamp(2.2rem,4.5vw,3rem);background:#000;padding:0 14px;display:inline-block;margin:0;line-height:1.2">Vicepresidente</p>
          </div>
        </div>
      </div>

      <div class="reveal-content" id="reveal-white">
        <div class="reveal-cards">
          <div class="drag-card" data-left="5" data-top="8">
            <div class="card-role">Nickname</div>
            <div class="card-nick">_AR3LYX1</div>
            <img class="hongo-gif" src="/hongo.gif" alt="" draggable="false" />
          </div>
          <div class="drag-card is-square folder-card" data-left="55" data-top="8">
            <img class="folder-git-img" src="/folderGit.png" alt="" draggable="false" />
            <div class="folder-label">Click The Folder</div>
          </div>
          <div class="drag-card card-email" data-left="55" data-top="56">
            <div class="email-content">
              <span class="email-text">andry.caceres@estudiante.ucsm.edu.pe</span>
              <img class="email-gif" src="/email.gif" alt="" draggable="false" />
            </div>
          </div>
          <div class="drag-card card-frame" data-left="28" data-top="24">
            <div class="frame-wrap">
              <img class="frame-bg" src="/arelyx.jpg" alt="" draggable="false" />
              <img class="frame-fg" src="/frame1.gif" alt="" draggable="false" />
            </div>
          </div>
          <div class="drag-card is-square" data-left="75" data-top="56">
            <img class="raver-gif" src="/raver.gif" alt="" draggable="false" />
          </div>
          <div class="drag-card is-square" data-left="75" data-top="30">
            <img class="rei-gif" src="/rei.gif" alt="" draggable="false" />
          </div>
<div class="drag-card github-streak-card" id="github-modal" data-left="40" data-top="30" style="display: none; z-index: 100; min-width:320px; max-width:90vw;">
  <div class="github-modal-window">
    <div class="win-titlebar">
      <span class="win-icon"><img src="/folderGit.png" alt="" style="width:16px;height:16px;image-rendering:pixelated;vertical-align:middle;margin-right:4px" /></span>
      <span class="win-title">GitHub Streak</span>
      <button class="win-close" id="github-streak-close">✕</button>
    </div>
    <div class="win-body">
      <img src="https://streak-stats.demolab.com?user=ArelyX1&theme=radical&hide_border=true&exclude_days=Sun%2CTue%2CFri" alt="GitHub Streak" />
    </div>
  </div>
</div>
<div class="drag-card instagram-modal-card" id="instagram-modal" data-left="35" data-top="15" style="display: none; z-index: 100; min-width:380px; max-width:600px; width:540px;">
  <div class="github-modal-window">
    <div class="win-titlebar">
      <span class="win-icon"><img src="/email.gif" alt="" style="width:16px;height:16px;image-rendering:pixelated;vertical-align:middle;margin-right:4px" /></span>
      <span class="win-title">Instagram</span>
      <button class="win-close" id="instagram-modal-close">✕</button>
    </div>
    <div class="win-body" style="padding:0;">
      <iframe src="https://www.instagram.com/p/DXYXXUhDVDs/embed" width="100%" height="640" frameborder="0" scrolling="no" allowtransparency="true" style="border:none;overflow:hidden;display:block;"></iframe>
    </div>
  </div>
</div>
        </div>
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px"><span style="position:relative;display:inline-block">Andry Caceres<img class="comme-img" src="/comme.png" alt="" draggable="false" /></span></h2>
          <div class="presidente-border-wrap">
            <svg class="presidente-border-svg">
              <rect fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="6" stroke-dasharray="16 12" />
            </svg>
            <p class="presidente-text" style="font-family:'VT323',monospace;color:#fff;font-size:clamp(2.2rem,4.5vw,3rem);background:#000;padding:0 14px;display:inline-block;margin:0;line-height:1.2">Presidente</p>
          </div>
        </div>
      </div>

      <div class="reveal-intro" id="reveal-intro">
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px">Nuestro equipo</h2>
        </div>
      </div>

    </div>
  </section>

  <script type="module" src={base + "src/scripts/nosotros.js"}></script>
</BaseLayout>

<style>
  @font-face {
    font-family: 'Vintage';
    src: url('/fonts/215000E.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
  }
  .scroll-reveal {
    position: relative;
    background: rgba(13, 20, 13, 0.65);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0;
    min-height: 3000vh;
  }

  .separator-bar {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--green);
    letter-spacing: 4px;
    white-space: nowrap;
    overflow: hidden;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    user-select: none;
  }

  .reveal-stage {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .reveal-purple {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    background: #660099;
    opacity: 0;
    will-change: opacity;
  }

  .reveal-purple .section-title { color: #fff; }
  .reveal-purple .accent5 { color: #ffcc00; }
  .reveal-purple p { color: #ecc; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 2vw, 20px);
    padding: 0 8px;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
    padding: clamp(12px, 2vw, 20px) 8px;
    backdrop-filter: blur(4px);
    transition: transform 0.2s, background 0.2s;
  }

  .team-card:hover {
    transform: translateY(-3px);
    background: rgba(255,255,255,0.14);
  }

  .team-avatar,
  .team-avatar-placeholder {
    width: clamp(48px, 8vw, 80px);
    height: clamp(48px, 8vw, 80px);
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,0.3);
    flex-shrink: 0;
  }

  .team-avatar-placeholder {
    background: linear-gradient(135deg, #a855f7, #6366f1);
  }

  .team-name {
    font-family: 'VT323', monospace;
    font-size: clamp(14px, 1.5vw, 18px);
    font-weight: 700;
    color: #fff;
    text-align: center;
    line-height: 1.15;
  }

  .team-email {
    font-family: 'VT323', monospace;
    font-size: clamp(11px, 1vw, 14px);
    color: rgba(255,255,255,0.7);
    text-align: center;
    word-break: break-all;
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    #reveal-white .drag-card {
      display: none !important;
    }

    #reveal-white .card-email {
      display: flex !important;
    }
  }

  .reveal-green {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    background: #006600;
    opacity: 0;
    will-change: opacity;
  }

  .reveal-green .section-title { color: #fff; }
  .reveal-green .accent4 { color: #ffcc00; }
  .reveal-green p { color: #cfc; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .reveal-blue {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: #0033cc;
    opacity: 0;
    will-change: opacity;
  }

  .reveal-blue .section-title { color: #fff; }
  .reveal-blue .accent3 { color: #ffcc00; }
  .reveal-blue p { color: #ccf; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .reveal-red {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    background: #cc0000;
    opacity: 0;
    will-change: opacity, clip-path;
  }

  .reveal-red .section-title { color: #fff; }
  .reveal-red .accent2 { color: #ffcc00; }
  .reveal-red p { color: #fcc; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .reveal-intro {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 6;
    background: #000;
    opacity: 1;
    pointer-events: none;
    will-change: opacity;
  }

  .reveal-intro .section-title { color: #fff; }

  .reveal-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    background: #fff;
    background-image: url('/backAre.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    will-change: clip-path;
  }

  .content-inner {
    max-width: 720px;
    padding: 40px 24px;
    text-align: center;
    color: #111;
    position: relative;
  }

  .comme-img {
    position: absolute;
    top: -220px;
    right: -120px;
    width: 288px;
    rotate: 30deg;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .content-inner .section-title {
    color: #111;
  }

  .content-inner .accent {
    color: var(--green);
  }

  .content-inner p {
    color: #333;
    font-size: 16px;
    line-height: 1.8;
    margin-top: 20px;
  }

  .presidente-border-wrap {
    position: relative;
    display: inline-block;
    margin-top: 6px;
  }

  .presidente-border-svg {
    position: absolute;
    inset: -6px;
    width: calc(100% + 12px);
    height: calc(100% + 12px);
    pointer-events: none;
  }

  .presidente-border-svg rect {
    stroke-dasharray: 16 12;
    animation: dash-march 0.6s linear infinite;
  }

  @keyframes dash-march {
    to { stroke-dashoffset: -28; }
  }

  .reveal-cards {
    position: absolute;
    inset: 0;
    z-index: 10;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .drag-card {
    position: absolute;
    width: 38%;
    background: rgba(255,255,255,0.95);
    border: 2px solid #222;
    border-radius: 6px;
    padding: 20px 24px;
    cursor: grab;
    user-select: none;
    touch-action: none;
    pointer-events: auto;
    will-change: transform, left, top;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .drag-card.is-square {
    width: 18%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drag-card:first-child {
    width: 26%;
    background: url('/backID.gif') center/cover;
  }

  .hongo-gif {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: 100%;
    pointer-events: none;
  }

  .card-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    color: #FF4500;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .drag-card.is-square .card-role {
    margin-bottom: 0;
  }

  .card-nick {
    font-size: 32px;
    font-weight: 900;
    color: #F8F8FF;
    letter-spacing: 6px;
    -webkit-text-stroke: 1.5px #000;
    paint-order: stroke fill;
    text-shadow:
      2px 0 0 #F8F8FF,
      -2px 0 0 #F8F8FF,
      0 2px 0 #F8F8FF,
      0 -2px 0 #F8F8FF,
      0 0 8px rgba(255,0,0,0.6),
      0 0 16px rgba(255,0,0,0.4),
      0 0 24px rgba(0,0,0,0.5);
  }

  .drag-card.card-frame {
    width: 360px;
    height: 360px;
    padding: 0;
    overflow: visible;
    background: none;
    border: none;
    box-shadow: none;
    cursor: grab;
  }

  .frame-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .frame-bg {
    position: absolute;
    inset: 72px;
    width: calc(100% - 144px);
    height: calc(100% - 144px);
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .frame-fg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .raver-gif,
  .rei-gif,
  .folder-git-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .folder-card {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: none !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    width: 12%;
    aspect-ratio: auto;
    height: auto;
  }

  .folder-card .folder-git-img {
    width: 100%;
    aspect-ratio: 1;
    display: block;
  }

  .folder-label {
    font-family: 'VT323', monospace;
    font-size: clamp(16px, 2vw, 26px);
    font-weight: 700;
    color: #cae4c5;
    -webkit-text-stroke: 1px #000;
    paint-order: stroke fill;
    text-shadow: 0 0 3px #000;
    background: transparent;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    text-align: center;
    line-height: 1;
    margin-top: -20px;
  }

  .drag-card.is-square[data-left="75"][data-top="56"] {
    width: 12%;
    padding: 0;
    background: none;
    border: none;
  }

  .drag-card.is-square[data-left="75"][data-top="30"] {
    width: 32%;
    padding: 0;
    background: none;
    border: none;
    aspect-ratio: 4/3;
    height: auto;
  }

  .drag-card.is-square[data-left="55"][data-top="8"] {
    width: 12%;
    padding: 0;
    background: none;
    border: none;
  }

  .drag-card.card-email[data-left="55"][data-top="56"] {
    width: auto;
    background: #000;
    border: 10px solid transparent;
    border-image: url('/midfrrame.gif') 10 / 10px / 0 round;
    border-radius: 0;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
  }

  .email-content {
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }

  .email-text {
    font-family: 'VT323', monospace;
    font-size: clamp(16px, 2.4vw, 26px);
    color: #0f0;
    white-space: nowrap;
  }

  .email-gif {
    height: clamp(28px, 4vw, 40px);
    width: auto;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .instagram-modal-card {
    background: none !important;
    backdrop-filter: none;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  .github-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .github-modal.open {
    display: flex;
  }

  .github-modal.open .github-modal-window {
    animation: win-open 0.3s cubic-bezier(.34,1.56,.64,1) forwards;
  }

  @keyframes win-open {
    0% { scale: 0; opacity: 0; }
    100% { scale: 1; opacity: 1; }
  }

  .github-modal-window {
    background: #c0c0c0;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    font-family: 'VT323', monospace;
    min-width: 320px;
    max-width: 90vw;
  }

  .win-titlebar {
    display: flex;
    align-items: center;
    background: linear-gradient(90deg, #000080, #1084d0);
    color: #fff;
    padding: 4px 4px 4px 8px;
    font-size: 14px;
    user-select: none;
    gap: 4px;
  }

  .win-titlebar .win-close {
    margin-left: auto;
  }

  .win-icon {
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .win-close {
    width: 24px;
    height: 24px;
    background: #c0c0c0;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    color: #000;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
  }

  .win-close:active {
    border-color: #808080 #fff #fff #808080;
  }

  .win-body {
    padding: 8px;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.03) 2px,
      rgba(0,0,0,0.03) 4px
    );
  }

  .win-body img {
    display: block;
    width: 100%;
    height: auto;
    cursor: pointer;
  }

  .win-body img:hover {
    filter: brightness(1.1);
  }

.github-streak-card {
  background: none !important;
  backdrop-filter: none;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
}
</style>

<script>
  function generateSeparator() {
    const bar = document.getElementById('separator-bar');
    if (!bar) return;
    const char = '+\\\\+';
    const containerWidth = bar.parentElement.clientWidth;
    const charWidth = 40;
    const repeatCount = Math.ceil(containerWidth / charWidth) + 2;
    bar.textContent = new Array(repeatCount).fill(char).join('');
  }

  function initDragCards() {
    const cards = document.querySelectorAll('.drag-card');
    const container = document.querySelector('.reveal-cards');
    if (!cards.length || !container) return;

    let maxZ = 10;

    cards.forEach(card => {
      let leftPct = parseFloat(card.dataset.left);
      let topPct = parseFloat(card.dataset.top);
      if (!card.classList.contains('github-streak-card') && !card.classList.contains('instagram-modal-card')) {
        leftPct += (Math.random() - 0.5) * 30;
        topPct += (Math.random() - 0.5) * 30;
        const cardW = card.offsetWidth / container.offsetWidth * 100;
        const cardH = card.offsetHeight / container.offsetHeight * 100;
        leftPct = Math.max(0, Math.min(100 - cardW, leftPct));
        topPct = Math.max(0, Math.min(100 - cardH, topPct));
        if (leftPct > 18 && leftPct < 72 && topPct > 15 && topPct < 72) {
          leftPct = leftPct < 45 ? 8 : 72;
        }
      }
      card.style.left = leftPct + '%';
      card.style.top = topPct + '%';
      card.style.zIndex = maxZ++;

      let isDown = false, sx, sy, sl, st, lx, ly, lt;

      const onDown = (e) => {
        if (e.target.closest('.win-close') || e.target.closest('.win-body img')) return;
        isDown = true;
        maxZ++;
        card.style.zIndex = maxZ;
        card.style.scale = '1.05';
        card.style.cursor = 'grabbing';
        card.setPointerCapture(e.pointerId);

        const cr = container.getBoundingClientRect();
        const br = card.getBoundingClientRect();
        sx = e.clientX; sy = e.clientY;
        sl = br.left - cr.left; st = br.top - cr.top;
        lx = e.clientX; ly = e.clientY; lt = performance.now();
      };

      const clampPos = (leftPx, topPx) => {
        const cr = container.getBoundingClientRect();
        const cw = card.offsetWidth;
        const ch = card.offsetHeight;
        return {
          left: Math.max(0, Math.min(cr.width - cw, leftPx)),
          top: Math.max(0, Math.min(cr.height - ch, topPx)),
        };
      };

      const onMove = (e) => {
        if (!isDown) return;
        const p = clampPos(sl + e.clientX - sx, st + e.clientY - sy);
        card.style.left = p.left + 'px';
        card.style.top = p.top + 'px';
        lx = e.clientX; ly = e.clientY; lt = performance.now();
      };

      const onUp = (e) => {
        if (!isDown) return;
        isDown = false;
        card.style.scale = '1';
        card.style.cursor = 'grab';

        const dt = performance.now() - lt;
        if (dt > 0 && dt < 80) {
          const vx = ((e.clientX - lx) / dt) * 16;
          const vy = ((e.clientY - ly) / dt) * 16;
          if (Math.sqrt(vx * vx + vy * vy) > 2) {
            const cr = container.getBoundingClientRect();
            const br = card.getBoundingClientRect();
            card.style.transition = 'left 0.6s cubic-bezier(.22,1,.36,1), top 0.6s cubic-bezier(.22,1,.36,1)';
            const fp = clampPos(br.left - cr.left + vx * 8, br.top - cr.top + vy * 8);
            card.style.left = fp.left + 'px';
            card.style.top = fp.top + 'px';
            card.style.scale = '1';
            setTimeout(() => { card.style.transition = 'none'; }, 700);
          }
        }
      };

      const onCancel = () => {
        isDown = false;
        card.style.scale = '1';
        card.style.cursor = 'grab';
      };

      card.addEventListener('pointerdown', onDown);
      card.addEventListener('pointermove', onMove);
      card.addEventListener('pointerup', onUp);
      card.addEventListener('pointercancel', onCancel);
    });
  }

  function initReveal() {
    const introEl = document.getElementById('reveal-intro');
    const whiteEl = document.getElementById('reveal-white');
    const redEl = document.getElementById('reveal-red');
    const blueEl = document.getElementById('reveal-blue');
    const greenEl = document.getElementById('reveal-green');
    const purpleEl = document.getElementById('reveal-purple');
    const section = document.getElementById('scroll-reveal');
    if (!introEl || !whiteEl || !redEl || !blueEl || !greenEl || !purpleEl || !section) return;

    const STEPS = 7;
    const stairWidth = 8;
    const maxOffset = (STEPS - 1) * stairWidth;
    const total = 100 + maxOffset;

    const off1 = [];
    for (let i = 0; i < STEPS; i++) off1.push(i * stairWidth);
    for (let i = STEPS - 1; i >= 0; i--) off1.push(i * stairWidth);

    const off2 = [];
    for (let i = STEPS - 1; i >= 0; i--) off2.push(i * stairWidth);
    for (let i = 0; i < STEPS; i++) off2.push(i * stairWidth);

    const totalSteps = off1.length;
    const stepH = 100 / totalSteps;

    function poly1(p) {
      const sp = p * p * (3 - 2 * p);
      const pts = ['0% 0%'];
      for (let i = 0; i < totalSteps; i++) {
        const rx = Math.max(0, Math.min(100, sp * total - maxOffset + off1[i]));
        pts.push(`${rx}% ${i * stepH}%`, `${rx}% ${(i + 1) * stepH}%`);
      }
      pts.push('0% 100%');
      return `polygon(${pts.join(',')})`;
    }

    function polyStr(p, o) {
      const sp = p * p * (3 - 2 * p);
      const pts = ['0% 0%'];
      for (let i = 0; i < totalSteps; i++) {
        const rx = Math.max(0, Math.min(100, (1 - sp) * 100 - sp * maxOffset + o[i]));
        pts.push(`${rx}% ${i * stepH}%`, `${rx}% ${(i + 1) * stepH}%`);
      }
      pts.push('0% 100%');
      return `polygon(${pts.join(',')})`;
    }

    const sp = x => x * x * (3 - 2 * x);
    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = section.getBoundingClientRect();
        const wh = window.innerHeight;
        const totalScroll = rect.height + wh;
        const scrolled = wh - rect.top;
        const pt = Math.max(0, Math.min(1, scrolled / totalScroll));

        const split = 0.16;
        const p0 = 1 - Math.min(pt / split, 1);
        const p1 = Math.min(Math.max(pt - split, 0) / split, 1);
        const p2 = Math.min(Math.max(pt - split * 2, 0) / split, 1);
        const p3 = Math.min(Math.max(pt - split * 3, 0) / split, 1);
        const p4 = Math.min(Math.max(pt - split * 4, 0) / split, 1);
        const p5 = Math.min(Math.max(pt - split * 5, 0) / split, 1);

        introEl.style.opacity = p0;

        whiteEl.style.clipPath = p2 > 0 ? polyStr(p2, off2) : (p1 > 0 ? poly1(p1) : poly1(0));

        redEl.style.opacity = p2 > 0 ? sp(p2) : 0;
        redEl.style.clipPath = p3 > 0 ? polyStr(p3, off2) : 'none';

        blueEl.style.opacity = p3 > 0 ? sp(p3) : 0;
        blueEl.style.clipPath = p4 > 0 ? polyStr(p4, off2) : 'none';

        greenEl.style.opacity = p4 > 0 ? sp(p4) : 0;
        greenEl.style.clipPath = p5 > 0 ? polyStr(p5, off2) : 'none';

        purpleEl.style.opacity = p5 > 0 ? sp(p5) : 0;

        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  function initPresidenteBorder() {
    document.querySelectorAll('.presidente-border-wrap').forEach(wrap => {
      const svg = wrap.querySelector('.presidente-border-svg');
      const rect = svg.querySelector('rect');
      const update = () => {
        const w = wrap.offsetWidth;
        const h = wrap.offsetHeight;
        if (!w || !h) return;
        svg.setAttribute('viewBox', `0 0 ${w + 12} ${h + 12}`);
        rect.setAttribute('x', '2');
        rect.setAttribute('y', '2');
        rect.setAttribute('width', w + 8);
        rect.setAttribute('height', h + 8);
      };
      update();
      new ResizeObserver(update).observe(wrap);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    generateSeparator();
    initReveal();
    initDragCards();
    initPresidenteBorder();

    const showModal = (id, z) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.display = '';
      el.style.zIndex = z;
      const win = el.querySelector('.github-modal-window');
      if (win) {
        win.style.animation = 'none';
        void win.offsetHeight;
        win.style.animation = 'win-open 0.3s cubic-bezier(.34,1.56,.64,1) forwards';
      }
    };

    const folderGit = document.querySelector('.drag-card.is-square[data-left="55"][data-top="8"]');
    const gitModal = document.getElementById('github-modal');
    const gitClose = document.getElementById('github-streak-close');
    const gitImg = gitModal?.querySelector('.win-body img');
    if (folderGit && gitModal && gitClose) {
      folderGit.style.cursor = 'pointer';
      folderGit.addEventListener('click', () => {
        showModal('github-modal', 120);
        showModal('instagram-modal', 119);
      });
      gitClose.addEventListener('click', (e) => {
        gitModal.style.display = 'none';
        e.stopPropagation();
      });
      if (gitImg) {
        gitImg.addEventListener('click', () => {
          window.open('https://github.com/arelyX1/', '_blank');
        });
      }
    }

    const igClose = document.getElementById('instagram-modal-close');
    const igModal = document.getElementById('instagram-modal');
    if (igClose && igModal) {
      igClose.addEventListener('click', (e) => {
        igModal.style.display = 'none';
        e.stopPropagation();
      });
    }
  });

  window.addEventListener('resize', generateSeparator);
</script>
