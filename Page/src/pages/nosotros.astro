---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stats, badges, teamMembers, teamRoles } from '../nosotros/application/nosotros';
import '../nosotros/infrastructure/ui/styles/about.css';
import '../nosotros/infrastructure/ui/styles/team.css';
import '../nosotros/infrastructure/ui/styles/dragCards.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Nosotros">

  <section class="about section" id="about">
    <div class="container">
      <div class="section-label">// 01. QUIÉNES SOMOS</div>
      <div class="about-grid">
        <div class="about-text">
          <h2 class="section-title">Impulsando el futuro <span class="accent">tecnológico</span> del Perú</h2>
          <p>Somos el capítulo estudiantil de la <strong>Association for Computing Machinery (ACM)</strong> de la Universidad Católica de Santa María, una comunidad de estudiantes apasionados por la ingeniería, ciencias, el desarrollo de software y la innovación tecnológica.</p>
          <p>Fundado para conectar a estudiantes con recursos académicos de clase mundial, organizamos talleres, hackathons, charlas con la industria y proyectos colaborativos que potencian las habilidades técnicas y profesionales de nuestros miembros.</p>
          <div class="about-badges">
            {badges.map(b => <span class="badge">{b}</span>)}
          </div>
        </div>
        <div class="stat-grid">
          {stats.map(s => (
            <div class="stat-card">
              <div class="stat-num-big">{s.value}</div>
              <div class="stat-label-card">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="scroll-reveal" id="scroll-reveal">
    <div class="separator-bar" id="separator-bar"></div>

    <div class="reveal-stage" id="reveal-stage">
      <div class="reveal-purple" id="reveal-purple">
        <div class="content-inner" style="max-width:920px">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(3rem,6vw,6rem);margin-bottom:24px">Nuestro equipo</h2>
          <div class="team-grid">
            {teamMembers.map(m => (
              <div class="team-card">
                {m.image
                  ? <img class="team-avatar" src={m.image} alt="" draggable="false" />
                  : <div class="team-avatar-placeholder"></div>
                }
                <span class="team-name">{m.name}</span>
                <span class="team-email">{m.email}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {teamRoles.map(r => (
        <div class={`reveal-${r.color}`} id={`reveal-${r.color}`}>
          <div class="content-inner">
            <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px">{r.name}</h2>
            <div class="presidente-border-wrap">
              <svg class="presidente-border-svg">
                <rect fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="6" stroke-dasharray="16 12" />
              </svg>
              <p class="presidente-text" style="font-family:'VT323',monospace;color:#fff;font-size:clamp(2.2rem,4.5vw,3rem);background:#000;padding:0 14px;display:inline-block;margin:0;line-height:1.2">{r.role}</p>
            </div>
          </div>
        </div>
      ))}

      <div class="reveal-content" id="reveal-white">
        <div class="reveal-cards">
          <div class="drag-card" data-left="5" data-top="8">
            <div class="card-role">Nickname</div>
            <div class="card-nick">_AR3LYX1</div>
            <img class="hongo-gif" src="/hongo.gif" alt="" draggable="false" />
          </div>
          <div class="drag-card is-square folder-card" data-left="55" data-top="8">
            <img class="folder-git-img" src="/folderGit.png" alt="" draggable="false" />
            <div class="folder-label">Click The Folder</div>
          </div>
          <div class="drag-card card-email" data-left="55" data-top="56">
            <div class="email-content">
              <span class="email-text">andry.caceres@estudiante.ucsm.edu.pe</span>
              <img class="email-gif" src="/email.gif" alt="" draggable="false" />
            </div>
          </div>
          <div class="drag-card card-frame" data-left="28" data-top="24">
            <div class="frame-wrap">
              <img class="frame-bg" src="/arelyx.jpg" alt="" draggable="false" />
              <img class="frame-fg" src="/frame1.gif" alt="" draggable="false" />
            </div>
          </div>
          <div class="drag-card is-square" data-left="75" data-top="56">
            <img class="raver-gif" src="/raver.gif" alt="" draggable="false" />
          </div>
          <div class="drag-card is-square" data-left="75" data-top="30">
            <img class="rei-gif" src="/rei.gif" alt="" draggable="false" />
          </div>
          <div class="drag-card github-streak-card" id="github-modal" data-left="40" data-top="30" style="display: none; z-index: 100; min-width:320px; max-width:90vw;">
            <div class="github-modal-window">
              <div class="win-titlebar">
                <span class="win-icon"><img src="/folderGit.png" alt="" style="width:16px;height:16px;image-rendering:pixelated;vertical-align:middle;margin-right:4px" /></span>
                <span class="win-title">GitHub Streak</span>
                <button class="win-close" id="github-streak-close">✕</button>
              </div>
              <div class="win-body">
                <img src="https://streak-stats.demolab.com?user=ArelyX1&theme=radical&hide_border=true&exclude_days=Sun%2CTue%2CFri" alt="GitHub Streak" />
              </div>
            </div>
          </div>
          <div class="drag-card instagram-modal-card" id="instagram-modal" data-left="35" data-top="15" style="display: none; z-index: 100; min-width:380px; max-width:600px; width:540px;">
            <div class="github-modal-window">
              <div class="win-titlebar">
                <span class="win-icon"><img src="/email.gif" alt="" style="width:16px;height:16px;image-rendering:pixelated;vertical-align:middle;margin-right:4px" /></span>
                <span class="win-title">Instagram</span>
                <button class="win-close" id="instagram-modal-close">✕</button>
              </div>
              <div class="win-body" style="padding:0;">
                <iframe src="https://www.instagram.com/p/DXYXXUhDVDs/embed" width="100%" height="640" frameborder="0" scrolling="no" allowtransparency="true" style="border:none;overflow:hidden;display:block;"></iframe>
              </div>
            </div>
          </div>
        </div>
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px"><span style="position:relative;display:inline-block">Andry Caceres<img class="comme-img" src="/comme.png" alt="" draggable="false" /></span></h2>
          <div class="presidente-border-wrap">
            <svg class="presidente-border-svg">
              <rect fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="6" stroke-dasharray="16 12" />
            </svg>
            <p class="presidente-text" style="font-family:'VT323',monospace;color:#fff;font-size:clamp(2.2rem,4.5vw,3rem);background:#000;padding:0 14px;display:inline-block;margin:0;line-height:1.2">Presidente</p>
          </div>
        </div>
      </div>

      <div class="reveal-intro" id="reveal-intro">
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'Vintage','VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px">Nuestro equipo</h2>
        </div>
      </div>

    </div>
  </section>

  <script type="module" src={base + "src/nosotros/infrastructure/ui/scripts/counters.js"}></script>
</BaseLayout>

<script>
  import { generateSeparator, initDragCards, initPresidenteBorder, initModals } from '../nosotros/infrastructure/ui/scripts/dragCards.js';
  import { initReveal } from '../nosotros/infrastructure/ui/scripts/revealScroll.js';
  document.addEventListener('DOMContentLoaded', () => {
    generateSeparator();
    initReveal();
    initDragCards();
    initPresidenteBorder();
    initModals();
  });
  window.addEventListener('resize', generateSeparator);
</script>
