---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stats, badges } from '../nosotros/application/nosotros';
import '../nosotros/infrastructure/ui/styles/dragCards.css';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Nosotros">

  <section class="nosotros-section" id="nosotros-section">

    <button class="grid-back-btn" id="grid1-back">←</button>

    <div class="nosotros-grid" id="nosotros-grid">

      <!-- Grid 1: ACM / Datos -->
      <div class="grid-item" style="--grid-color:#28bca9" data-grid="1">
        <div class="grid-front">
          <h2 class="grid-title">ACM</h2>
          <p class="grid-sub">Datos</p>
        </div>
        <div class="grid-back">
          <div class="grid-back-content">
            <h2 class="back-heading">Impulsando el futuro <span style="color:#fff">tecnológico</span> del Perú</h2>
            <p class="back-desc">Somos el capítulo estudiantil de la <strong>Association for Computing Machinery (ACM)</strong> de la Universidad Católica de Santa María, una comunidad de estudiantes apasionados por la ingeniería, ciencias, el desarrollo de software y la innovación tecnológica.</p>
            <p class="back-desc">Fundado para conectar a estudiantes con recursos académicos de clase mundial, organizamos talleres, hackathons, charlas con la industria y proyectos colaborativos que potencian las habilidades técnicas y profesionales de nuestros miembros.</p>
            <div class="back-badges">
              {badges.map(b => <span class="back-badge">{b}</span>)}
            </div>
            <div class="back-stats">
              {stats.map(s => (
                <div class="back-stat">
                  <span class="back-stat-num">{s.value}</span>
                  <span class="back-stat-label">{s.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Grid 2: Directiva Ejecutiva -->
      <div class="grid-item" style="--grid-color:#fb4673" data-grid="2">
        <div class="grid-front">
          <h2 class="grid-title">Directiva<br>Ejecutiva</h2>
        </div>
        <div class="grid-list" id="grid-list">
          <div class="directive-entry" data-member="chair">
            <span class="de-var">chair</span><span class="de-op">_&gt;</span><span class="de-val">Andry Caceres</span>
          </div>
          <div class="directive-entry" data-member="vice-chair">
            <span class="de-var">vice-chair</span><span class="de-op">_&gt;</span><span class="de-val">Santiago Cusirramos</span>
          </div>
          <div class="directive-entry" data-member="treasurer">
            <span class="de-var">treasurer</span><span class="de-op">_&gt;</span><span class="de-val">Fernando Pacheco</span>
          </div>
          <div class="directive-entry" data-member="sponsor">
            <span class="de-var">sponsor</span><span class="de-op">_&gt;</span><span class="de-val">Christian Revilla</span>
          </div>
        </div>
      </div>

      <!-- Grid 3: Directiva de Proyectos -->
      <div class="grid-item" style="--grid-color:#99cccc" data-grid="3">
        <div class="grid-front">
          <h2 class="grid-title">Directiva<br>de Proyectos</h2>
        </div>
      </div>

      <!-- Grid 4: Marketing y Comunicación -->
      <div class="grid-item" style="--grid-color:#223634" data-grid="4">
        <div class="grid-front">
          <h2 class="grid-title">Marketing y<br>Comunicación</h2>
        </div>
      </div>

      <!-- Grid 5: Logística y RR.PP. -->
      <div class="grid-item" style="--grid-color:#ff9900" data-grid="5">
        <div class="grid-front">
          <h2 class="grid-title">Logística y<br>Relaciones Públicas</h2>
        </div>
      </div>

      <!-- Grid 6: Dev Team -->
      <div class="grid-item" style="--grid-color:#00cc99" data-grid="6">
        <div class="grid-front">
          <h2 class="grid-title">Dev Team</h2>
        </div>
      </div>

    </div>

    <!-- Chair overlay (column 3) -->
    <div class="chair-overlay" id="chair-overlay">
      <button class="chair-close" id="chair-close">✕</button>
      <div class="reveal-cards" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none">
        <div class="drag-card" data-left="5" data-top="8">
          <div class="card-role">Nickname</div>
          <div class="card-nick">_AR3LYX1</div>
          <img class="hongo-gif" src="/hongo.gif" alt="" draggable="false" />
        </div>
        <div class="drag-card is-square folder-card" data-left="55" data-top="8">
          <img class="folder-git-img" src="/folderGit.png" alt="" draggable="false" />
          <div class="folder-label">Click The Folder</div>
        </div>
        <div class="drag-card card-email" data-left="55" data-top="56">
          <div class="email-content">
            <span class="email-text">andry.caceres@estudiante.ucsm.edu.pe</span>
            <img class="email-gif" src="/email.gif" alt="" draggable="false" />
          </div>
        </div>
        <div class="drag-card card-frame" data-left="28" data-top="24">
          <div class="frame-wrap">
            <img class="frame-bg" src="/arelyx.jpg" alt="" draggable="false" />
            <img class="frame-fg" src="/frame1.gif" alt="" draggable="false" />
          </div>
        </div>
        <div class="drag-card is-square" data-left="75" data-top="56">
          <img class="raver-gif" src="/raver.gif" alt="" draggable="false" />
        </div>
        <div class="drag-card is-square" data-left="75" data-top="30">
          <img class="rei-gif" src="/rei.gif" alt="" draggable="false" />
        </div>
        <div class="drag-card github-streak-card" id="github-modal" data-left="40" data-top="30" style="display:none;z-index:100;min-width:320px;max-width:90vw">
          <div class="github-modal-window">
            <div class="win-titlebar">
              <span class="win-icon"><img src="/folderGit.png" alt="" style="width:16px;height:16px;image-rendering:pixelated;vertical-align:middle;margin-right:4px" /></span>
              <span class="win-title">GitHub Streak</span>
              <button class="win-close" id="github-streak-close">✕</button>
            </div>
            <div class="win-body">
              <img src="https://streak-stats.demolab.com?user=ArelyX1&theme=radical&hide_border=true&exclude_days=Sun%2CTue%2CFri" alt="GitHub Streak" />
            </div>
          </div>
        </div>
        <div class="drag-card instagram-modal-card" id="instagram-modal" data-left="35" data-top="15" style="display:none;z-index:100;min-width:380px;max-width:600px;width:540px">
          <div class="github-modal-window">
            <div class="win-titlebar">
              <span class="win-icon"><img src="/email.gif" alt="" style="width:16px;height:16px;image-rendering:pixelated;vertical-align:middle;margin-right:4px" /></span>
              <span class="win-title">Instagram</span>
              <button class="win-close" id="instagram-modal-close">✕</button>
            </div>
            <div class="win-body" style="padding:0">
              <iframe src="https://www.instagram.com/p/DXYXXUhDVDs/embed" width="100%" height="640" frameborder="0" scrolling="no" allowtransparency="true" style="border:none;overflow:hidden;display:block"></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>

  </section>

</BaseLayout>

<style>
  .nosotros-section {
    position: relative;
    height: 100vh;
    padding-top: 60px;
    overflow: hidden;
  }

  .nosotros-grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    width: 100%;
    height: 100%;
    transition: grid-template-columns 0.5s ease;
  }

  .grid-back-btn {
    position: fixed;
    top: 76px;
    left: 16px;
    z-index: 100;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.4);
    background: rgba(0,0,0,0.35);
    color: #fff;
    font-size: 1.2rem;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
    backdrop-filter: blur(4px);
  }

  .grid-back-btn:hover {
    background: rgba(0,0,0,0.55);
    border-color: rgba(255,255,255,0.6);
  }

  .grid-back-btn.visible {
    display: flex;
  }

  .nosotros-grid.grid1-expanded {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .nosotros-grid.chair-active {
    grid-template-columns: 0.85fr 1fr 1fr;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid rgba(0,0,0,0.15);
    border-bottom: 1px solid rgba(0,0,0,0.15);
    background: var(--grid-color);
  }

  .grid-item:nth-child(3),
  .grid-item:nth-child(6) {
    border-right: none;
  }

  .grid-item:nth-child(4),
  .grid-item:nth-child(5),
  .grid-item:nth-child(6) {
    border-bottom: none;
  }

  .grid-item.grid1-open {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    cursor: default;
    z-index: 10;
  }

  .grid-item.list-open {
    cursor: default;
  }

  .grid-front {
    text-align: center;
    padding: 20px;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .grid-item.grid1-open .grid-front {
    opacity: 0;
    pointer-events: none;
  }

  .grid-item.list-open .grid-front {
    opacity: 0;
  }

  .grid-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 2.2rem);
    font-weight: 800;
    color: rgba(255,255,255,0.95);
    line-height: 1.15;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0,0,0,0.2);
  }

  .grid-sub {
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.65rem, 1.2vw, 0.85rem);
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.15em;
    margin: 6px 0 0;
    text-transform: uppercase;
  }

  .grid-item:not(.grid1-open):not(.list-open):hover {
    filter: brightness(1.12);
    scale: 1.02;
    z-index: 5;
  }

  /* ── Grid 1 Expanded ── */
  .grid-back {
    position: absolute;
    inset: 0;
    padding: 40px 48px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease 0.1s;
    overflow-y: auto;
  }

  .grid-item.grid1-open .grid-back {
    opacity: 1;
    pointer-events: auto;
  }

  .grid-back-content {
    max-width: 680px;
    margin: auto;
    text-align: left;
  }

  .back-heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin: 0 0 20px;
  }

  .back-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin: 0 0 14px;
  }

  .back-desc strong {
    color: #fff;
  }

  .back-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 28px;
  }

  .back-badge {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    padding: 5px 12px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.05em;
  }

  .back-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .back-stat {
    text-align: center;
    padding: 16px 8px;
    background: rgba(0,0,0,0.15);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
  }

  .back-stat-num {
    display: block;
    font-family: 'Orbitron', 'Space Mono', monospace;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin-bottom: 4px;
  }

  .back-stat-label {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.5rem, 0.8vw, 0.6rem);
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.1em;
  }

  /* ── Grid 2 List ── */
  .grid-list {
    position: absolute;
    inset: 0;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease 0.1s;
  }

  .grid-item.list-open .grid-list {
    opacity: 1;
    pointer-events: auto;
  }

  .directive-entry {
    font-family: 'VT323', 'Space Mono', monospace;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: rgba(255,255,255,0.85);
    cursor: pointer;
    padding: 8px 12px;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
    display: flex;
    align-items: baseline;
    gap: 4px;
    flex-wrap: wrap;
  }

  .directive-entry:hover {
    background: rgba(0,0,0,0.15);
    color: #fff;
  }

  .de-var {
    color: #fff;
    font-weight: 700;
  }

  .de-op {
    color: rgba(255,255,255,0.4);
    margin: 0 4px;
  }

  .de-val {
    color: rgba(255,255,255,0.6);
  }

  .directive-entry:hover .de-val {
    color: #fff;
  }

  /* ── Chair Overlay ── */
  .chair-overlay {
    position: absolute;
    top: 0;
    right: 0;
    width: 33.333%;
    height: 100%;
    z-index: 50;
    background: #f5f0e8;
    border-left: 2px solid #222;
    transform: translateX(100%);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }

  .chair-overlay.open {
    transform: translateX(0);
  }

  .chair-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 60;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #222;
    background: rgba(255,255,255,0.9);
    color: #222;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .chair-close:hover {
    background: #222;
    color: #fff;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nosotros-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, 1fr);
    }

    .grid-item:nth-child(3) {
      border-right: none;
    }

    .grid-item:nth-child(4) {
      border-bottom: 1px solid rgba(0,0,0,0.15);
    }

    .grid-item.grid1-open {
      grid-column: 1 / 3;
      grid-row: 1 / 4;
    }

    .grid-back {
      padding: 24px 20px;
    }

    .back-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .chair-overlay {
      width: 100%;
    }

    .grid-list {
      padding: 20px;
    }
  }
</style>

<script>
  import { initDragCards, initPresidenteBorder, initModals } from '../nosotros/infrastructure/ui/scripts/dragCards.js';

  const grid = document.getElementById('nosotros-grid');
  if (!grid) throw new Error('nosotros-grid not found');
  const items = grid.querySelectorAll('.grid-item');
  const chairOverlay = document.getElementById('chair-overlay');
  const chairClose = document.getElementById('chair-close');

  const grid1 = items[0];
  const grid1Back = document.getElementById('grid1-back');

  grid1.addEventListener('click', () => {
    if (grid1.classList.contains('grid1-open')) return;
    grid1.classList.add('grid1-open');
    grid.classList.add('grid1-expanded');
    grid1Back?.classList.add('visible');
  });

  grid1Back?.addEventListener('click', () => {
    grid1.classList.remove('grid1-open');
    grid.classList.remove('grid1-expanded');
    grid1Back?.classList.remove('visible');
  });

  const grid2 = items[1];

  grid2.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement | null;
    if (grid2.classList.contains('list-open') || target?.closest('.directive-entry')) return;
    grid2.classList.toggle('list-open');
  });

  document.querySelectorAll('.directive-entry').forEach(entry => {
    entry.addEventListener('click', (e: Event) => {
      e.stopPropagation();
      const member = (entry as HTMLElement).dataset.member;
      if (member === 'chair') {
        chairOverlay?.classList.add('open');
        setTimeout(() => {
          initDragCards();
          initPresidenteBorder();
          initModals();
        }, 100);
      }
    });
  });

  chairClose?.addEventListener('click', () => {
    chairOverlay?.classList.remove('open');
  });
</script>
