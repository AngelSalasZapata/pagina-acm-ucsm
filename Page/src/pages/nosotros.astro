---
// src/pages/nosotros.astro
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Nosotros">

    <!-- ABOUT -->
  <section class="about section" id="about">
    <div class="container">
      <div class="section-label">// 01. QUIÉNES SOMOS</div>
      <div class="about-grid">
        <div class="about-text">
          <h2 class="section-title">Impulsando el futuro <span class="accent">tecnológico</span> del Perú</h2>
          <p>Somos el capítulo estudiantil de la <strong>Association for Computing Machinery (ACM)</strong> de la Universidad Católica de Santa María, una comunidad de estudiantes apasionados por la ingeniería, ciencias, el desarrollo de software y la innovación tecnológica.</p>
          <p>Fundado para conectar a estudiantes con recursos académicos de clase mundial, organizamos talleres, hackathons, charlas con la industria y proyectos colaborativos que potencian las habilidades técnicas y profesionales de nuestros miembros.</p>
          <div class="about-badges">
            <span class="badge">Programación</span>
            <span class="badge">IA &amp; ML</span>
            <span class="badge">Ciberseguridad</span>
            <span class="badge">Open Source</span>
            <span class="badge">Redes</span>
            <span class="badge">Robótica</span>
            <span class="badge">Computación Cuántica</span>
          </div>
        </div>
        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-num-big">120+</div>
            <div class="stat-label-card">MIEMBROS ACTIVOS</div>
          </div>
          <div class="stat-card">
            <div class="stat-num-big">1°</div>
            <div class="stat-label-card">AÑO INICIANDO</div>
          </div>
          <div class="stat-card">
            <div class="stat-num-big">40+</div>
            <div class="stat-label-card">EVENTOS AL AÑO</div>
          </div>
          <div class="stat-card">
            <div class="stat-num-big">8</div>
            <div class="stat-label-card">PROYECTOS ACTIVOS</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SCROLL REVEAL SECTION ── -->
  <section class="scroll-reveal" id="scroll-reveal">
    <div class="separator-bar" id="separator-bar"></div>

    <div class="reveal-stage" id="reveal-stage">
      <div class="reveal-purple" id="reveal-purple">
        <div class="content-inner">
          <h2 class="section-title">Team</h2>
          <p>El futuro es ahora. Nuevos desafíos, nuevas oportunidades y un camino de transformación y evolución constante.</p>
        </div>
      </div>

      <div class="reveal-green" id="reveal-green">
        <div class="content-inner">
          <h2 class="section-title">Christian</h2>
          <p>El futuro es ahora. Nuevos desafíos, nuevas oportunidades y un camino de transformación y evolución constante.</p>
        </div>
      </div>

      <div class="reveal-blue" id="reveal-blue">
        <div class="content-inner">
          <h2 class="section-title">Fernando</h2>
          <p>El futuro es ahora. Nuevos desafíos, nuevas oportunidades y un camino de transformación y evolución constante.</p>
        </div>
      </div>

      <div class="reveal-red" id="reveal-red">
        <div class="content-inner">
          <h2 class="section-title">Santiago</h2>
          <p>El futuro es ahora. Nuevos desafíos, nuevas oportunidades y un camino de transformación y evolución constante.</p>
        </div>
      </div>

      <div class="reveal-content" id="reveal-white">
        <div class="reveal-cards">
          <div class="drag-card" data-left="5" data-top="8">
            <div class="card-role">Nickname</div>
            <div class="card-nick">_AR3LYX1</div>
            <img class="hongo-gif" src="/hongo.gif" alt="" draggable="false" />
          </div>
          <div class="drag-card is-square" data-left="55" data-top="8">
            <img class="folder-git-img" src="/folderGit.png" alt="" draggable="false" />
          </div>
          <div class="drag-card is-square" data-left="5" data-top="56">
            <div class="card-role">ig</div>
          </div>
          <div class="drag-card" data-left="55" data-top="56">
            <div class="card-role">otros</div>
          </div>
          <div class="drag-card card-frame" data-left="28" data-top="24">
            <div class="frame-wrap">
              <img class="frame-bg" src="/arelyx.jpg" alt="" draggable="false" />
              <img class="frame-fg" src="/frame1.gif" alt="" draggable="false" />
            </div>
          </div>
          <div class="drag-card is-square" data-left="75" data-top="56">
            <img class="raver-gif" src="/raver.gif" alt="" draggable="false" />
          </div>
          <div class="drag-card is-square" data-left="75" data-top="30">
            <img class="rei-gif" src="/rei.gif" alt="" draggable="false" />
          </div>
<div class="drag-card github-streak-card" id="github-modal" data-left="40" data-top="30" style="display: none; z-index: 100; min-width:320px; max-width:90vw;">
  <div class="github-modal-window">
    <div class="win-titlebar">
      <span class="win-title">GitHub Streak</span>
      <button class="win-close" id="github-streak-close" style="position:absolute;top:0;right:0;width:32px;height:32px;line-height:32px;background:#c0c0c0;border:2px solid #808080;box-shadow:0 2px 4px #2228;z-index:9999;font-size:20px;cursor:pointer;pointer-events:auto;">✕</button>
    </div>
    <div class="win-body">
      <img src="https://streak-stats.demolab.com?user=ArelyX1&theme=radical&hide_border=true&exclude_days=Sun%2CTue%2CFri" alt="GitHub Streak" />
    </div>
  </div>
</div>
        </div>
        <div class="content-inner">
          <h2 class="section-title" style="font-family:'VT323',monospace;color:#cae4c5;font-size:clamp(6rem,12vw,9rem);margin-bottom:4px"><span style="position:relative;display:inline-block">Andry<img class="comme-img" src="/comme.png" alt="" draggable="false" /></span></h2>
          <div class="presidente-border-wrap">
            <svg class="presidente-border-svg">
              <rect fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="6" stroke-dasharray="16 12" />
            </svg>
            <p class="presidente-text" style="font-family:'VT323',monospace;color:#fff;font-size:clamp(2.2rem,4.5vw,3rem);background:#000;padding:0 14px;display:inline-block;margin:0;line-height:1.2">Presidente</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <script type="module" src={base + "src/scripts/nosotros.js"}></script>
</BaseLayout>

<style>
  .scroll-reveal {
    position: relative;
    background: rgba(13, 20, 13, 0.65);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0;
    min-height: 3000vh;
  }

  .separator-bar {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--green);
    letter-spacing: 4px;
    white-space: nowrap;
    overflow: hidden;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    user-select: none;
  }

  .reveal-stage {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .reveal-purple {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    background: #660099;
    opacity: 0;
    will-change: opacity;
  }

  .reveal-purple .section-title { color: #fff; }
  .reveal-purple .accent5 { color: #ffcc00; }
  .reveal-purple p { color: #ecc; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .reveal-green {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    background: #006600;
    opacity: 0;
    will-change: opacity;
  }

  .reveal-green .section-title { color: #fff; }
  .reveal-green .accent4 { color: #ffcc00; }
  .reveal-green p { color: #cfc; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .reveal-blue {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: #0033cc;
    opacity: 0;
    will-change: opacity;
  }

  .reveal-blue .section-title { color: #fff; }
  .reveal-blue .accent3 { color: #ffcc00; }
  .reveal-blue p { color: #ccf; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .reveal-red {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    background: #cc0000;
    opacity: 0;
    will-change: opacity, clip-path;
  }

  .reveal-red .section-title { color: #fff; }
  .reveal-red .accent2 { color: #ffcc00; }
  .reveal-red p { color: #fcc; font-size: 16px; line-height: 1.8; margin-top: 20px; }

  .reveal-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    background: #fff;
    background-image: url('/backAre.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    will-change: clip-path;
  }

  .content-inner {
    max-width: 720px;
    padding: 40px 24px;
    text-align: center;
    color: #111;
    position: relative;
  }

  .comme-img {
    position: absolute;
    top: -220px;
    right: -120px;
    width: 288px;
    rotate: 30deg;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .content-inner .section-title {
    color: #111;
  }

  .content-inner .accent {
    color: var(--green);
  }

  .content-inner p {
    color: #333;
    font-size: 16px;
    line-height: 1.8;
    margin-top: 20px;
  }

  .presidente-border-wrap {
    position: relative;
    display: inline-block;
    margin-top: 6px;
  }

  .presidente-border-svg {
    position: absolute;
    inset: -6px;
    width: calc(100% + 12px);
    height: calc(100% + 12px);
    pointer-events: none;
  }

  .presidente-border-svg rect {
    stroke-dasharray: 16 12;
    animation: dash-march 0.6s linear infinite;
  }

  @keyframes dash-march {
    to { stroke-dashoffset: -28; }
  }

  .reveal-cards {
    position: absolute;
    inset: 0;
    z-index: 10;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .drag-card {
    position: absolute;
    width: 38%;
    background: rgba(255,255,255,0.95);
    border: 2px solid #222;
    border-radius: 6px;
    padding: 20px 24px;
    cursor: grab;
    user-select: none;
    touch-action: none;
    pointer-events: auto;
    will-change: transform, left, top;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .drag-card.is-square {
    width: 18%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drag-card:first-child {
    width: 26%;
    background: url('/backID.gif') center/cover;
  }

  .hongo-gif {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: 100%;
    pointer-events: none;
  }

  .card-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    color: #FF4500;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .drag-card.is-square .card-role {
    margin-bottom: 0;
  }

  .card-nick {
    font-size: 32px;
    font-weight: 900;
    color: #F8F8FF;
    letter-spacing: 6px;
    -webkit-text-stroke: 1.5px #000;
    paint-order: stroke fill;
    text-shadow:
      2px 0 0 #F8F8FF,
      -2px 0 0 #F8F8FF,
      0 2px 0 #F8F8FF,
      0 -2px 0 #F8F8FF,
      0 0 8px rgba(255,0,0,0.6),
      0 0 16px rgba(255,0,0,0.4),
      0 0 24px rgba(0,0,0,0.5);
  }

  .drag-card.card-frame {
    width: 360px;
    height: 360px;
    padding: 0;
    overflow: visible;
    background: none;
    border: none;
    box-shadow: none;
    cursor: grab;
  }

  .frame-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .frame-bg {
    position: absolute;
    inset: 72px;
    width: calc(100% - 144px);
    height: calc(100% - 144px);
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .frame-fg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .raver-gif,
  .rei-gif,
  .folder-git-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .drag-card.is-square[data-left="75"][data-top="56"] {
    width: 12%;
    padding: 0;
    background: none;
    border: none;
  }

  .drag-card.is-square[data-left="75"][data-top="30"] {
    width: 32%;
    padding: 0;
    background: none;
    border: none;
    aspect-ratio: 4/3;
    height: auto;
  }

  .drag-card.is-square[data-left="55"][data-top="8"] {
    width: 12%;
    padding: 0;
    background: none;
    border: none;
  }

  .github-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .github-modal.open {
    display: flex;
  }

  .github-modal.open .github-modal-window {
    animation: win-open 0.3s cubic-bezier(.34,1.56,.64,1) forwards;
  }

  @keyframes win-open {
    0% { scale: 0; opacity: 0; }
    100% { scale: 1; opacity: 1; }
  }

  .github-modal-window {
    background: #c0c0c0;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    font-family: 'VT323', monospace;
    min-width: 320px;
    max-width: 90vw;
  }

  .win-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(90deg, #000080, #1084d0);
    color: #fff;
    padding: 4px 4px 4px 8px;
    font-size: 14px;
    user-select: none;
  }

  .win-close {
    width: 24px;
    height: 24px;
    background: #c0c0c0;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    color: #000;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
  }

  .win-close:active {
    border-color: #808080 #fff #fff #808080;
  }

  .win-body {
    padding: 8px;
  }

  .win-body img {
    display: block;
    width: 100%;
    height: auto;
  }

.github-streak-card {
  background: rgba(255,255,255,0.18) !important;
  backdrop-filter: blur(2px);
  box-shadow: 0 2px 12px 0 rgba(0,0,0,0.18), 0 0 1px white;
}
</style>

<script>
  function generateSeparator() {
    const bar = document.getElementById('separator-bar');
    if (!bar) return;
    const char = '+\\\\+';
    const containerWidth = bar.parentElement.clientWidth;
    const charWidth = 40;
    const repeatCount = Math.ceil(containerWidth / charWidth) + 2;
    bar.textContent = new Array(repeatCount).fill(char).join('');
  }

  function initDragCards() {
    const cards = document.querySelectorAll('.drag-card');
    const container = document.querySelector('.reveal-cards');
    if (!cards.length || !container) return;

    let maxZ = 10;

    cards.forEach(card => {
      const leftPct = parseFloat(card.dataset.left);
      const topPct = parseFloat(card.dataset.top);
      card.style.left = leftPct + '%';
      card.style.top = topPct + '%';
      card.style.zIndex = maxZ++;

      let isDown = false, sx, sy, sl, st, lx, ly, lt;

      const onDown = (e) => {
        isDown = true;
        maxZ++;
        card.style.zIndex = maxZ;
        card.style.scale = '1.05';
        card.style.cursor = 'grabbing';
        card.setPointerCapture(e.pointerId);

        const cr = container.getBoundingClientRect();
        const br = card.getBoundingClientRect();
        sx = e.clientX; sy = e.clientY;
        sl = br.left - cr.left; st = br.top - cr.top;
        lx = e.clientX; ly = e.clientY; lt = performance.now();
      };

      const onMove = (e) => {
        if (!isDown) return;
        card.style.left = (sl + e.clientX - sx) + 'px';
        card.style.top = (st + e.clientY - sy) + 'px';
        lx = e.clientX; ly = e.clientY; lt = performance.now();
      };

      const onUp = (e) => {
        if (!isDown) return;
        isDown = false;
        card.style.scale = '1';
        card.style.cursor = 'grab';

        const dt = performance.now() - lt;
        if (dt > 0 && dt < 80) {
          const vx = ((e.clientX - lx) / dt) * 16;
          const vy = ((e.clientY - ly) / dt) * 16;
          if (Math.sqrt(vx * vx + vy * vy) > 2) {
            const cr = container.getBoundingClientRect();
            const br = card.getBoundingClientRect();
            card.style.transition = 'left 0.6s cubic-bezier(.22,1,.36,1), top 0.6s cubic-bezier(.22,1,.36,1)';
            card.style.left = (br.left - cr.left + vx * 8) + 'px';
            card.style.top = (br.top - cr.top + vy * 8) + 'px';
            card.style.scale = '1';
            setTimeout(() => { card.style.transition = 'none'; }, 700);
          }
        }
      };

      const onCancel = () => {
        isDown = false;
        card.style.scale = '1';
        card.style.cursor = 'grab';
      };

      card.addEventListener('pointerdown', onDown);
      card.addEventListener('pointermove', onMove);
      card.addEventListener('pointerup', onUp);
      card.addEventListener('pointercancel', onCancel);
    });
  }

  function initReveal() {
    const whiteEl = document.getElementById('reveal-white');
    const redEl = document.getElementById('reveal-red');
    const blueEl = document.getElementById('reveal-blue');
    const greenEl = document.getElementById('reveal-green');
    const purpleEl = document.getElementById('reveal-purple');
    const section = document.getElementById('scroll-reveal');
    if (!whiteEl || !redEl || !blueEl || !greenEl || !purpleEl || !section) return;

    const STEPS = 7;
    const stairWidth = 8;
    const maxOffset = (STEPS - 1) * stairWidth;
    const total = 100 + maxOffset;

    const off1 = [];
    for (let i = 0; i < STEPS; i++) off1.push(i * stairWidth);
    for (let i = STEPS - 1; i >= 0; i--) off1.push(i * stairWidth);

    const off2 = [];
    for (let i = STEPS - 1; i >= 0; i--) off2.push(i * stairWidth);
    for (let i = 0; i < STEPS; i++) off2.push(i * stairWidth);

    const totalSteps = off1.length;
    const stepH = 100 / totalSteps;

    function poly1(p) {
      const sp = p * p * (3 - 2 * p);
      const pts = ['0% 0%'];
      for (let i = 0; i < totalSteps; i++) {
        const rx = Math.max(0, Math.min(100, sp * total - maxOffset + off1[i]));
        pts.push(`${rx}% ${i * stepH}%`, `${rx}% ${(i + 1) * stepH}%`);
      }
      pts.push('0% 100%');
      return `polygon(${pts.join(',')})`;
    }

    function polyStr(p, o) {
      const sp = p * p * (3 - 2 * p);
      const pts = ['0% 0%'];
      for (let i = 0; i < totalSteps; i++) {
        const rx = Math.max(0, Math.min(100, (1 - sp) * 100 - sp * maxOffset + o[i]));
        pts.push(`${rx}% ${i * stepH}%`, `${rx}% ${(i + 1) * stepH}%`);
      }
      pts.push('0% 100%');
      return `polygon(${pts.join(',')})`;
    }

    const sp = x => x * x * (3 - 2 * x);
    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = section.getBoundingClientRect();
        const wh = window.innerHeight;
        const totalScroll = rect.height + wh;
        const scrolled = wh - rect.top;
        const pt = Math.max(0, Math.min(1, scrolled / totalScroll));

        const split = 0.19;
        const p1 = Math.min(pt / split, 1);
        const p2 = pt > split ? Math.min((pt - split) / split, 1) : 0;
        const p3 = pt > split * 2 ? Math.min((pt - split * 2) / split, 1) : 0;
        const p4 = pt > split * 3 ? Math.min((pt - split * 3) / split, 1) : 0;
        const p5 = pt > split * 4 ? Math.min((pt - split * 4) / split, 1) : 0;

        whiteEl.style.clipPath = p2 > 0 ? polyStr(p2, off2) : (pt > 0 ? poly1(p1) : poly1(0));

        if (p2 > 0) {
          redEl.style.opacity = sp(p2);
        } else {
          redEl.style.clipPath = 'none';
        }

        if (p3 > 0) {
          redEl.style.clipPath = polyStr(p3, off2);
          blueEl.style.opacity = sp(p3);
        } else {
          blueEl.style.clipPath = 'none';
        }

        if (p4 > 0) {
          blueEl.style.clipPath = polyStr(p4, off2);
          greenEl.style.opacity = sp(p4);
        } else {
          greenEl.style.clipPath = 'none';
        }

        if (p5 > 0) {
          greenEl.style.clipPath = polyStr(p5, off2);
          purpleEl.style.opacity = sp(p5);
        }

        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  function initPresidenteBorder() {
    const wrap = document.querySelector('.presidente-border-wrap');
    if (!wrap) return;
    const svg = wrap.querySelector('.presidente-border-svg');
    const rect = svg.querySelector('rect');
    const update = () => {
      const w = wrap.offsetWidth;
      const h = wrap.offsetHeight;
      if (!w || !h) return;
      svg.setAttribute('viewBox', `0 0 ${w + 12} ${h + 12}`);
      rect.setAttribute('x', '2');
      rect.setAttribute('y', '2');
      rect.setAttribute('width', w + 8);
      rect.setAttribute('height', h + 8);
    };
    update();
    new ResizeObserver(update).observe(wrap);
  }

  document.addEventListener('DOMContentLoaded', () => {
    generateSeparator();
    initReveal();
    initDragCards();
    initPresidenteBorder();

    const folderGit = document.querySelector('.drag-card.is-square[data-left="55"][data-top="8"]');
    const modal = document.getElementById('github-modal');
    const closeBtn = document.getElementById('win-close');
    if (folderGit && modal && closeBtn) {
      folderGit.style.cursor = 'pointer';
      folderGit.addEventListener('click', () => {
        modal.classList.add('open');
        modal.querySelector('.github-modal-window').style.animation = 'none';
        void modal.querySelector('.github-modal-window').offsetHeight;
        modal.querySelector('.github-modal-window').style.animation = '';
      });
      closeBtn.addEventListener('click', () => modal.classList.remove('open'));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('open');
      });
    }
  });

  window.addEventListener('resize', generateSeparator);
</script>
