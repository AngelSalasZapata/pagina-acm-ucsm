---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEvents } from '../eventos/application/events';
import '../eventos/infrastructure/ui/styles/events.css';
const events = getEvents();
---
<BaseLayout title="Eventos">
  <section class="events section" id="events">
    <div class="container">
      <div class="section-label">// 03. CALENDARIO DE EVENTOS</div>
      <h2 class="section-title">Próximas <span class="accent">actividades</span></h2>
      <div class="events-timeline">
        {events.map(event => (
          <div class="event-card reveal">
            <div class="event-date-block">
              <span class="event-day">{event.day}</span>
              <span class="event-month">{event.month}</span>
            </div>
            <div class="event-img-wrap">
              <img src={event.image} alt={event.title} loading="lazy" />
              <div class="event-tag">{event.tag}</div>
            </div>
            <div class="event-body">
              <h3>{event.title}</h3>
              <p>{event.description}</p>
              <div class="event-meta">
                <span>📍 {event.location}</span>
                <span>⏱ {event.duration}</span>
                <span>👥 {event.capacity}</span>
              </div>
              <a href="#contact" class="event-btn">{event.buttonText}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <script>import('../eventos/infrastructure/ui/scripts/events.js');</script>
</BaseLayout>
