---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getInfoItems } from '../informacion/application/info';
import '../informacion/infrastructure/ui/styles/info.css';
const infoItems = getInfoItems();
---
<BaseLayout title="Información">
  <section class="info section" id="info">
    <div class="container">
      <div class="section-label">// 02. INFORMACIÓN</div>
      <h2 class="section-title centered">¿Qué hacemos <span class="accent">exactamente</span>?</h2>
      <div class="info-grid">
        {infoItems.map(item => (
          <div class="info-item">
            <div class="info-num">{item.number}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <script>import('../informacion/infrastructure/ui/scripts/infoReveal.js');</script>
</BaseLayout>
